#version 450
#extension GL_EXT_shader_image_load_formatted : require
// Formatless readonly storage images preserve the imported RGBA/BGRA view.
// No reinterpretation as R32UI and no texture-sampler shadow allocation.
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0) readonly uniform image2D previousFrame;
layout(set=0,binding=1) readonly uniform image2D currentFrame;
layout(set=0,binding=2,std430) buffer Scratch { uint flags[512]; uint colors[512]; };
layout(push_constant) uniform Params { uint width; uint height; uint scenario; uint spare; } p;
shared uint combined;
void main() {
    if (gl_LocalInvocationIndex == 0u) combined = 0u;
    memoryBarrierShared(); barrier();
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 64;
    vec3 first = imageLoad(currentFrame, origin).rgb;
    uint localFlags = 0u;
    for (int y=0; y<64; y+=16) for (int x=0; x<64; x+=16) {
        ivec2 q = origin + ivec2(gl_LocalInvocationID.xy) + ivec2(x,y);
        if (all(lessThan(q, ivec2(p.width,p.height)))) {
            vec3 value = imageLoad(currentFrame,q).rgb;
            localFlags |= any(notEqual(value,imageLoad(previousFrame,q).rgb)) ? 1u : 0u;
            localFlags |= any(notEqual(value,first)) ? 2u : 0u;
        }
    }
    if (localFlags != 0u) atomicOr(combined,localFlags);
    memoryBarrierShared(); barrier();
    if (gl_LocalInvocationIndex == 0u) {
        uint tile = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        flags[tile] = combined;
        colors[tile] = packUnorm4x8(vec4(first,1.0));
    }
}
