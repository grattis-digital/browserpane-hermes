{
  "name": "browserpane-hermes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/playwright-patch/apply.mjs",
    "check:playwright": "node scripts/playwright-patch/apply.mjs --check",
    "build": "npm run check:enhancement && node scripts/build.mjs",
    "check:enhancement": "tsc -p client/enhancement/tsconfig.json",
    "test:enhancement": "node --test test/smart-upscale-*.test.mjs && node scripts/check-smart-upscale.mjs",
    "test": "node --test test/*.test.mjs",
    "test:client": "node scripts/test-client.mjs",
    "test:linux": "bash scripts/test-pipeline-linux.sh",
    "test:webgl": "node scripts/check-webgl-pixels.mjs && node scripts/check-renderer-fallback.mjs",
    "test:scroll": "node scripts/check-scroll-integrity.mjs",
    "test:display": "node scripts/check-display-controls.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
    "test:mcp": "node scripts/check-compact-engine.mjs && node scripts/check-click-completion.mjs",
    "bench:mcp": "node scripts/benchmark-mcp-baseline.mjs",
    "bench:scoped": "node scripts/benchmark-scoped-mcp.mjs",
    "bench:workflow": "node scripts/benchmark-workflow-learning.mjs",
    "bench:replay": "node scripts/benchmark-workflow-replay.mjs",
    "bench:warm": "node scripts/benchmark-workflow-warm.mjs",
    "test:warm": "node scripts/check-workflow-warm.mjs",
    "test:replay": "node scripts/check-workflow-replay.mjs",
    "test:pacing": "node scripts/check-workflow-pacing.mjs",
    "start": "node server/main.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.68",
    "fzstd": "0.1.1",
    "playwright-core": "1.59.0-alpha-1771104257000",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.72",
    "esbuild": "0.25.9",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
