# Compose settings only. Do not put model API keys in this file.
# Default: accessible from this Docker host only.
BIND_ADDRESS=127.0.0.1
VIEWER_HOST=localhost
HTTPS_PORT=8443
GATEWAY_PORT=4433
TZ=UTC
BPANE_MCP_MODE=compact
# Compatibility fallback: playwright (original tools, same profile/session).
# Optional content-free JSON timing records in bounded container logs.
BPANE_MCP_TIMINGS=0

# LAN opt-in: replace BIND_ADDRESS with the host's LAN IPv4 address, and
# VIEWER_HOST with that address or a DNS hostname resolving to it.
# Trust only Caddy's exported root.crt on each viewing device (see docs/SECURITY.md).
# Anyone who can reach this viewer can control the shared, logged-in browser.
