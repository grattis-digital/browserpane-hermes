@@ -0,0 +1,44 @@
+use super::*;
+
+#[test]
+#[ignore = "requires disposable X11 display with MIT-SHM"]
+fn regional_and_packed_reads_account_for_shm_and_getimage_without_extra_owned_copy() {
+    let display = std::env::var("DISPLAY").unwrap();
+    let size = (128, 96);
+    let mut cap = X11CaptureBackend::new(&display, size.0.into(), size.1.into()).unwrap();
+    assert!(cap.shm.is_some());
+    let region = PixelRect::new((3, 7, 7, 9), size).unwrap();
+    for shared in [true, false] {
+        if !shared {
+            cap.shm = None;
+        }
+        let mut full = Vec::new();
+        let mut timing = ReadbackTiming::default();
+        cap.capture_region_raw_into_timed((0, 0, size.0, size.1), &mut full, &mut timing)
+            .unwrap();
+        assert_eq!(timing.shm_requests, u64::from(shared));
+        assert_eq!(timing.get_image_requests, u64::from(!shared));
+        assert_eq!(
+            timing.copy_bytes,
+            if shared { full.len() as u64 } else { 0 }
+        );
+        assert_eq!(
+            (timing.request_us, timing.copy_us),
+            (0, 0),
+            "disabled clocks stay off"
+        );
+        let mut actual = vec![79; full.len()];
+        let mut expected = actual.clone();
+        region.copy(size, &full, &mut expected, false).unwrap();
+        let mut timing = ReadbackTiming {
+            enabled: true,
+            ..Default::default()
+        };
+        cap.capture_into_frame_timed(region, size, &mut actual, &mut timing)
+            .unwrap();
+        assert_eq!(actual, expected, "odd-width rows must match packed capture");
+        assert_eq!(timing.shm_requests, u64::from(shared));
+        assert_eq!(timing.get_image_requests, u64::from(!shared));
+        assert_eq!(timing.copy_bytes, 7 * 9 * 4);
+    }
+}
