@@ -0,0 +1,219 @@
+use super::*;
+
+const SIZE: (u16, u16) = (128, 96);
+const SMALL: (u16, u16, u16, u16) = (3, 5, 7, 9);
+
+fn read(
+    truth: &[u8],
+    size: (u16, u16),
+    region: Option<PixelRect>,
+    target: &mut Vec<u8>,
+) -> anyhow::Result<()> {
+    if let Some(region) = region {
+        region.copy(size, truth, target, false)?;
+    } else {
+        target.clear();
+        target.extend_from_slice(truth);
+    }
+    Ok(())
+}
+
+#[test]
+fn rotated_buffers_preserve_disjoint_and_overlapping_history_without_full_copies() {
+    let mut capture = DamageReadback::new(true);
+    let mut previous: Option<Vec<u8>> = None;
+    let mut scratch = Vec::new();
+    let mut truth = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+    let mut previous_area = 0;
+    for n in 0..1000u16 {
+        let bounds = (
+            n.wrapping_mul(17) % 110,
+            n.wrapping_mul(31) % 76,
+            7 + n % 11,
+            9 + n % 11,
+        );
+        let region = PixelRect::new(bounds, SIZE).unwrap();
+        let packed = vec![(n % 251) as u8; region.pixels() as usize * 4];
+        region.copy(SIZE, &packed, &mut truth, true).unwrap();
+        let before = previous.clone();
+        let stats = capture
+            .capture(
+                SIZE,
+                Some(bounds),
+                false,
+                previous.as_deref(),
+                &mut scratch,
+                |r, dst| read(&truth, SIZE, r, dst),
+            )
+            .unwrap();
+        assert_eq!(scratch, truth, "frame {n}");
+        assert_eq!(previous, before, "previous frame must remain immutable");
+        if n > 0 {
+            assert!(stats.regional);
+            assert_eq!(stats.requested_pixels, region.pixels());
+        }
+        if n > 1 {
+            assert_eq!(stats.repair_bytes, previous_area * 4);
+        }
+        previous_area = region.pixels();
+        if let Some(old) = previous.replace(std::mem::take(&mut scratch)) {
+            scratch = old;
+        }
+    }
+}
+
+#[test]
+fn full_capture_cannot_assume_only_acknowledged_bounds_changed() {
+    let mut capture = DamageReadback::new(true);
+    let mut scratch = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+    let previous = scratch.clone();
+    capture
+        .capture(
+            SIZE,
+            Some(SMALL),
+            true,
+            Some(&previous),
+            &mut scratch,
+            |_, frame| {
+                frame.fill(81);
+                Ok(())
+            },
+        )
+        .unwrap();
+    let previous = scratch.clone();
+    scratch.fill(0);
+    let stats = capture
+        .capture(
+            SIZE,
+            Some(SMALL),
+            false,
+            Some(&previous),
+            &mut scratch,
+            |region, frame| {
+                region.unwrap().copy(SIZE, &previous, frame, false)?;
+                Ok(())
+            },
+        )
+        .unwrap();
+    assert!(stats.regional);
+    assert_eq!(
+        stats.repair_bytes,
+        previous.len() as u64,
+        "one-time epoch seed must be counted"
+    );
+    assert_eq!(
+        scratch, previous,
+        "extra changes from full capture must survive rotation"
+    );
+}
+
+#[test]
+fn disabled_unknown_broad_invalid_or_forced_damage_uses_full_capture() {
+    for (enabled, damage, force) in [
+        (false, Some(SMALL), false),
+        (true, None, false),
+        (true, Some((0, 0, 128, 96)), false),
+        (true, Some((127, 0, 2, 2)), false),
+        (true, Some((0, 0, 0, 2)), false),
+        (true, Some(SMALL), true),
+    ] {
+        let mut capture = DamageReadback::new(enabled);
+        capture.size = Some(SIZE);
+        let previous = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+        let mut scratch = previous.clone();
+        let stats = capture
+            .capture(
+                SIZE,
+                damage,
+                force,
+                Some(&previous),
+                &mut scratch,
+                |r, _| {
+                    assert!(r.is_none());
+                    Ok(())
+                },
+            )
+            .unwrap();
+        assert!(!stats.regional);
+        assert_eq!(stats.repair_bytes, 0);
+    }
+}
+
+#[test]
+fn failed_partial_write_recaptures_full_and_disables_region_until_new_session() {
+    let mut capture = DamageReadback::new(true);
+    capture.size = Some(SIZE);
+    let previous = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+    let mut scratch = previous.clone();
+    let stats = capture
+        .capture(
+            SIZE,
+            Some(SMALL),
+            false,
+            Some(&previous),
+            &mut scratch,
+            |r, frame| {
+                frame.fill(7);
+                if r.is_some() {
+                    anyhow::bail!("injected partial mutation then error");
+                }
+                frame.fill(9);
+                Ok(())
+            },
+        )
+        .unwrap();
+    assert!(stats.fallback && !stats.regional);
+    assert!(scratch.iter().all(|b| *b == 9));
+    assert_eq!(
+        stats.requested_pixels,
+        u64::from(SIZE.0) * u64::from(SIZE.1) + 63
+    );
+    capture
+        .capture(
+            SIZE,
+            Some(SMALL),
+            false,
+            Some(&previous),
+            &mut scratch,
+            |r, _| {
+                assert!(r.is_none());
+                Ok(())
+            },
+        )
+        .unwrap();
+}
+
+#[test]
+fn failed_full_capture_resize_and_missing_previous_invalidate_region_history() {
+    let mut capture = DamageReadback::new(true);
+    let mut scratch = Vec::new();
+    assert!(capture
+        .capture(SIZE, None, false, None, &mut scratch, |_, _| anyhow::bail!(
+            "failure"
+        ))
+        .is_err());
+    assert_eq!(capture.size, None);
+    capture.size = Some(SIZE);
+    assert!(capture
+        .region((96, 128), Some(SMALL), false, Some(&vec![0; 128 * 96 * 4]))
+        .is_none());
+    assert!(capture.region(SIZE, Some(SMALL), false, None).is_none());
+    capture.invalidate();
+    assert!(capture
+        .region(SIZE, Some(SMALL), false, Some(&vec![0; 128 * 96 * 4]))
+        .is_none());
+}
+
+#[test]
+fn strided_odd_width_edge_regions_leave_every_other_pixel_untouched() {
+    for bounds in [(0, 0, 1, 1), (126, 95, 2, 1), (3, 7, 7, 9)] {
+        let rect = PixelRect::new(bounds, SIZE).unwrap();
+        let packed = vec![37; rect.pixels() as usize * 4];
+        let mut target = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+        rect.copy(SIZE, &packed, &mut target, true).unwrap();
+        assert_eq!(target.iter().filter(|v| **v == 37).count(), packed.len());
+        assert!(rect
+            .copy(SIZE, &packed[..packed.len() - 1], &mut target, true)
+            .is_err());
+    }
+}
