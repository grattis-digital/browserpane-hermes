@@ -0,0 +1,72 @@
+//! Validated packed-BGRA region operations. No allocation or borrowed SHM escapes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct PixelRect {
+    x: u16,
+    y: u16,
+    w: u16,
+    h: u16,
+}
+
+impl PixelRect {
+    pub(crate) fn new(bounds: (u16, u16, u16, u16), size: (u16, u16)) -> Option<Self> {
+        let (x, y, w, h) = bounds;
+        (w > 0
+            && h > 0
+            && x <= i16::MAX as u16
+            && y <= i16::MAX as u16
+            && u32::from(x) + u32::from(w) <= u32::from(size.0)
+            && u32::from(y) + u32::from(h) <= u32::from(size.1))
+        .then_some(Self { x, y, w, h })
+    }
+
+    pub(crate) fn bounds(self) -> (u16, u16, u16, u16) {
+        (self.x, self.y, self.w, self.h)
+    }
+    pub(crate) fn pixels(self) -> u64 {
+        u64::from(self.w) * u64::from(self.h)
+    }
+
+    pub(crate) fn frame_bytes(size: (u16, u16)) -> anyhow::Result<usize> {
+        anyhow::ensure!(size.0 > 0 && size.1 > 0, "Empty capture geometry");
+        usize::from(size.0)
+            .checked_mul(usize::from(size.1))
+            .and_then(|n| n.checked_mul(4))
+            .ok_or_else(|| anyhow::anyhow!("Capture geometry overflow"))
+    }
+
+    pub(crate) fn copy(
+        self,
+        size: (u16, u16),
+        source: &[u8],
+        target: &mut [u8],
+        packed: bool,
+    ) -> anyhow::Result<u64> {
+        anyhow::ensure!(
+            Self::new(self.bounds(), size).is_some(),
+            "Region outside capture geometry"
+        );
+        let frame_bytes = Self::frame_bytes(size)?;
+        let source_bytes = if packed {
+            self.pixels() as usize * 4
+        } else {
+            frame_bytes
+        };
+        anyhow::ensure!(
+            target.len() == frame_bytes && source.len() == source_bytes,
+            "Invalid capture storage length"
+        );
+        let stride = usize::from(size.0) * 4;
+        let row_bytes = usize::from(self.w) * 4;
+        for row in 0..usize::from(self.h) {
+            let target_start = (usize::from(self.y) + row) * stride + usize::from(self.x) * 4;
+            let source_start = if packed {
+                row * row_bytes
+            } else {
+                target_start
+            };
+            target[target_start..target_start + row_bytes]
+                .copy_from_slice(&source[source_start..source_start + row_bytes]);
+        }
+        Ok(self.pixels() * 4)
+    }
+}
