index 0000000..d48af83
--- /dev/null
+++ b/code/apps/bpane-host/src/tile_loop/readback.rs
@@ -0,0 +1,123 @@
+//! Opt-in regional readback, retaining TWO complete owned BGRA frames.
+//! After a regional capture the other buffer differs only inside that region.
+//! Repair it from the immutable previous frame before reading new pixels. A full
+//! capture can include later/unreported damage, so its difference is UNKNOWN;
+//! the next regional frame seeds once from the full previous image. Never assume
+//! full readback changed only the acknowledged damage bounds.
+use crate::capture::region::PixelRect;
+
+#[derive(Default, Debug)]
+pub(super) struct ReadbackStats {
+    pub regional: bool,
+    pub fallback: bool,
+    /// Requested pixels, including a failed region attempt before full fallback.
+    pub requested_pixels: u64,
+    /// Buffer-history repair copies, separate from X11 readback/scatter copies.
+    pub repair_bytes: u64,
+    pub repair_us: u64,
+}
+
+pub(super) struct DamageReadback {
+    enabled: bool,
+    size: Option<(u16, u16)>,
+    changed: Option<PixelRect>,
+    timings: bool,
+}
+
+impl DamageReadback {
+    pub fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            size: None,
+            changed: None,
+            timings: false,
+        }
+    }
+    pub fn set_timings(&mut self, enabled: bool) {
+        self.timings = enabled;
+    }
+    pub fn invalidate(&mut self) {
+        self.size = None;
+        self.changed = None;
+    }
+
+    fn region(
+        &self,
+        size: (u16, u16),
+        damage: Option<(u16, u16, u16, u16)>,
+        force: bool,
+        previous: Option<&[u8]>,
+    ) -> Option<PixelRect> {
+        if !self.enabled
+            || force
+            || self.size != Some(size)
+            || previous?.len() != PixelRect::frame_bytes(size).ok()?
+        {
+            return None;
+        }
+        let region = PixelRect::new(damage?, size)?;
+        // Conservative initial experiment: one bounding rectangle, <= 1/8 of
+        // the root. Scroll/full repaint stays on the established full path.
+        (region.pixels() * 8 <= u64::from(size.0) * u64::from(size.1)).then_some(region)
+    }
+
+    pub fn capture(
+        &mut self,
+        size: (u16, u16),
+        damage: Option<(u16, u16, u16, u16)>,
+        force: bool,
+        previous: Option<&[u8]>,
+        current: &mut Vec<u8>,
+        mut read: impl FnMut(Option<PixelRect>, &mut Vec<u8>) -> anyhow::Result<()>,
+    ) -> anyhow::Result<ReadbackStats> {
+        let selected = self.region(size, damage, force, previous);
+        let prior_change = self.changed;
+        self.invalidate(); // Any error, including partial destination mutation, invalidates history.
+        let mut stats = ReadbackStats::default();
+        if let (Some(region), Some(previous)) = (selected, previous) {
+            let repair_start = self.timings.then(std::time::Instant::now);
+            stats.repair_bytes = match (current.len() == previous.len(), prior_change) {
+                (true, Some(rect)) => rect.copy(size, previous, current, false)?,
+                _ => {
+                    current.clear();
+                    current.extend_from_slice(previous);
+                    previous.len() as u64
+                }
+            };
+            stats.repair_us =
+                crate::capture::readback_timing::ReadbackTiming::elapsed(repair_start);
+            stats.requested_pixels = region.pixels();
+            match read(Some(region), current) {
+                Ok(()) => {
+                    self.changed = Some(region);
+                    stats.regional = true;
+                }
+                Err(error) => {
+                    // A failed capability/read must not repeatedly seed/copy a
+                    // full frame while pretending to be a cheap regional path.
+                    self.enabled = false;
+                    stats.fallback = true;
+                    tracing::warn!(%error, "experimental regional readback disabled for this session");
+                }
+            }
+        }
+        if !stats.regional {
+            stats.requested_pixels += u64::from(size.0) * u64::from(size.1);
+            read(None, current)?;
+        }
+        anyhow::ensure!(
+            current.len() == PixelRect::frame_bytes(size)?,
+            "Incomplete capture frame"
+        );
+        self.size = Some(size);
+        Ok(stats)
+    }
+}
