@@ -0,0 +1,29 @@
+//! Diagnostic-only clocks. X11 reply wait includes server work/synchronization;
+//! it is NOT a GPU timer. Copies count explicit bytes, not DRAM bus traffic.
+use std::time::Instant;
+
+#[derive(Default)]
+pub(crate) struct ReadbackTiming {
+    pub enabled: bool,
+    pub request_us: u64,
+    pub copy_us: u64,
+    pub copy_bytes: u64,
+    pub shm_requests: u64,
+    pub get_image_requests: u64,
+}
+
+impl ReadbackTiming {
+    pub fn start(&self) -> Option<Instant> {
+        self.enabled.then(Instant::now)
+    }
+    pub fn waited(&mut self, start: Option<Instant>) {
+        self.request_us += Self::elapsed(start);
+    }
+    pub fn copied(&mut self, start: Option<Instant>, bytes: usize) {
+        self.copy_us += Self::elapsed(start);
+        self.copy_bytes += bytes as u64;
+    }
+    pub fn elapsed(start: Option<Instant>) -> u64 {
+        start.map(|t| t.elapsed().as_micros() as u64).unwrap_or(0)
+    }
+}
