@@ -0,0 +1,126 @@
+use super::*;
+use crate::capture::x11::{DamageTracker, X11CaptureBackend};
+use std::sync::{atomic::AtomicU64, Arc};
+use x11rb::{
+    connection::Connection,
+    protocol::xproto::{ConnectionExt, CreateGCAux, Rectangle},
+};
+
+#[test]
+#[ignore = "requires disposable X11 display"]
+fn regional_x11_pixels_preserve_damage_arriving_after_acknowledgement() {
+    let display = std::env::var("DISPLAY").unwrap();
+    let (paint, screen) = x11rb::connect(Some(&display)).unwrap();
+    let root = paint.setup().roots[screen].root;
+    let size = (
+        paint.setup().roots[screen].width_in_pixels,
+        paint.setup().roots[screen].height_in_pixels,
+    );
+    let mut cap = X11CaptureBackend::new(&display, size.0.into(), size.1.into()).unwrap();
+    let mut tracker = DamageTracker::for_tile_capture(&display, Arc::new(AtomicU64::new(0)))
+        .unwrap()
+        .unwrap();
+    let gc = paint.generate_id().unwrap();
+    paint
+        .create_gc(gc, root, &CreateGCAux::new().foreground(0x314f7b))
+        .unwrap()
+        .check()
+        .unwrap();
+    let mut state = DamageReadback::new(true);
+    let mut scratch = Vec::new();
+    let mut reference = Vec::new();
+    tracker.begin_capture_for_size(size.0, size.1);
+    state
+        .capture(size, None, true, None, &mut scratch, |r, dst| match r {
+            Some(r) => cap.capture_into_frame(r, size, dst),
+            None => cap.capture_region_raw_into(0, 0, size.0, size.1, dst),
+        })
+        .unwrap();
+    let mut previous = Some(std::mem::take(&mut scratch));
+    for step in 0..12u16 {
+        let rectangle = Rectangle {
+            x: (7 + step * 19) as i16,
+            y: (9 + step * 17) as i16,
+            width: 7,
+            height: 9,
+        };
+        paint
+            .poly_fill_rectangle(root, gc, &[rectangle])
+            .unwrap()
+            .check()
+            .unwrap();
+        let bounds = tracker.begin_capture_for_size(size.0, size.1);
+        assert!(bounds.is_some());
+        // A second update AFTER acknowledge must remain pending.
+        let late = Rectangle {
+            x: (701 + step * 11) as i16,
+            y: 601,
+            width: 5,
+            height: 3,
+        };
+        paint
+            .poly_fill_rectangle(root, gc, &[late])
+            .unwrap()
+            .check()
+            .unwrap();
+        let stats = state
+            .capture(
+                size,
+                bounds,
+                false,
+                previous.as_deref(),
+                &mut scratch,
+                |r, dst| match r {
+                    Some(r) => cap.capture_into_frame(r, size, dst),
+                    None => cap.capture_region_raw_into(0, 0, size.0, size.1, dst),
+                },
+            )
+            .unwrap();
+        assert!(stats.regional && !stats.fallback);
+        if let Some(old) = previous.replace(std::mem::take(&mut scratch)) {
+            scratch = old;
+        }
+        let pending = tracker.begin_capture_for_size(size.0, size.1);
+        assert!(pending.is_some(), "late damage disappeared");
+        state
+            .capture(
+                size,
+                pending,
+                false,
+                previous.as_deref(),
+                &mut scratch,
+                |r, dst| match r {
+                    Some(r) => cap.capture_into_frame(r, size, dst),
+                    None => cap.capture_region_raw_into(0, 0, size.0, size.1, dst),
+                },
+            )
+            .unwrap();
+        cap.capture_region_raw_into(0, 0, size.0, size.1, &mut reference)
+            .unwrap();
+        assert_eq!(
+            scratch, reference,
+            "regional reads must converge to the whole root"
+        );
+        if let Some(old) = previous.replace(std::mem::take(&mut scratch)) {
+            scratch = old;
+        }
+    }
+    tracker.force_refresh();
+    paint
+        .poly_fill_rectangle(
+            root,
+            gc,
+            &[Rectangle {
+                x: 1,
+                y: 2,
+                width: 3,
+                height: 4,
+            }],
+        )
+        .unwrap()
+        .check()
+        .unwrap();
+    assert!(tracker.begin_capture_for_size(size.0, size.1).is_none());
+    assert!(tracker.begin_capture_for_size(size.0 - 1, size.1).is_none());
+    paint.free_gc(gc).unwrap().check().unwrap();
+}
