diff --git a/code/apps/bpane-host/src/capture/x11/regional.rs b/code/apps/bpane-host/src/capture/x11/regional.rs
new file mode 100644
index 0000000..8476abd
--- /dev/null
+++ b/code/apps/bpane-host/src/capture/x11/regional.rs
@@ -0,0 +1,176 @@
+//! One fenced X11 read shared by packed/full and strided/regional consumers.
+use super::X11CaptureBackend;
+use crate::capture::{readback_timing::ReadbackTiming, region::PixelRect};
+
+#[cfg(target_os = "linux")]
+enum Pixels<'a> {
+    Shared(&'a [u8]),
+    Owned(Vec<u8>),
+}
+
+#[cfg(all(test, target_os = "linux"))]
+#[path = "regional_tests.rs"]
+mod tests;
+
+impl X11CaptureBackend {
+    #[cfg(target_os = "linux")]
+    fn read_pixels(
+        &self,
+        bounds: (u16, u16, u16, u16),
+        timing: &mut ReadbackTiming,
+        store: impl FnOnce(Pixels<'_>, &mut ReadbackTiming) -> anyhow::Result<()>,
+    ) -> anyhow::Result<()> {
+        use x11rb::connection::Connection;
+        use x11rb::protocol::shm::ConnectionExt as _;
+        use x11rb::protocol::xproto::{ConnectionExt as _, ImageFormat};
+        let (x, y, w, h) = bounds;
+        anyhow::ensure!(
+            x <= i16::MAX as u16 && y <= i16::MAX as u16,
+            "Invalid X11 capture origin"
+        );
+        let bytes = PixelRect::frame_bytes((w, h))?;
+        let setup = self.conn.setup();
+        let depth = setup
+            .roots
+            .iter()
+            .find(|s| s.root == self.root)
+            .map(|s| s.root_depth);
+        anyhow::ensure!(
+            setup
+                .pixmap_formats
+                .iter()
+                .any(|f| Some(f.depth) == depth && f.bits_per_pixel == 32 && f.scanline_pad == 32),
+            "Readback requires packed 32-bit pixels"
+        );
+        if let Some(shm) = self.shm.as_ref().filter(|shm| bytes <= shm.size) {
+            let start = timing.start();
+            timing.shm_requests += 1;
+            let reply = self
+                .conn
+                .shm_get_image(
+                    self.root,
+                    x as i16,
+                    y as i16,
+                    w,
+                    h,
+                    !0,
+                    ImageFormat::Z_PIXMAP.into(),
+                    shm.seg_id,
+                    0,
+                )?
+                .reply();
+            timing.waited(start);
+            match reply {
+                Ok(reply) => {
+                    anyhow::ensure!(
+                        reply.size as usize == bytes && Some(reply.depth) == depth,
+                        "Unexpected SHM pixel format/size"
+                    );
+                    // Reply completion fences the server write. The consumer must
+                    // copy before the next request, never retain the borrowed SHM.
+                    return store(Pixels::Shared(&shm.as_slice()[..bytes]), timing);
+                }
+                Err(error) => tracing::warn!(%error, "SHM capture failed; trying GetImage"),
+            }
+        }
+        let start = timing.start();
+        timing.get_image_requests += 1;
+        let reply = self
+            .conn
+            .get_image(
+                ImageFormat::Z_PIXMAP,
+                self.root,
+                x as i16,
+                y as i16,
+                w,
+                h,
+                !0,
+            )?
+            .reply();
+        timing.waited(start);
+        let reply = reply?;
+        anyhow::ensure!(
+            Some(reply.depth) == depth && reply.data.len() == bytes,
+            "Unexpected GetImage pixel format/size"
+        );
+        store(Pixels::Owned(reply.data), timing)
+    }
+
+    #[cfg(target_os = "linux")]
+    pub(crate) fn capture_region_raw_into_timed(
+        &mut self,
+        bounds: (u16, u16, u16, u16),
+        data: &mut Vec<u8>,
+        timing: &mut ReadbackTiming,
+    ) -> anyhow::Result<()> {
+        self.read_pixels(bounds, timing, |pixels, timing| {
+            match pixels {
+                Pixels::Shared(bytes) => {
+                    let start = timing.start();
+                    data.clear();
+                    data.extend_from_slice(bytes);
+                    timing.copied(start, bytes.len());
+                }
+                // Preserve the existing GetImage allocation's ownership; no extra copy.
+                Pixels::Owned(bytes) => *data = bytes,
+            }
+            Ok(())
+        })
+    }
+
+    #[cfg(target_os = "linux")]
+    pub(crate) fn capture_into_frame_timed(
+        &mut self,
+        region: PixelRect,
+        size: (u16, u16),
+        frame: &mut [u8],
+        timing: &mut ReadbackTiming,
+    ) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            PixelRect::new(region.bounds(), size).is_some()
+                && frame.len() == PixelRect::frame_bytes(size)?,
+            "Invalid regional destination"
+        );
+        self.read_pixels(region.bounds(), timing, |pixels, timing| {
+            let bytes = match &pixels {
+                Pixels::Shared(bytes) => *bytes,
+                Pixels::Owned(bytes) => bytes.as_slice(),
+            };
+            let start = timing.start();
+            region.copy(size, bytes, frame, true)?;
+            timing.copied(start, bytes.len());
+            Ok(())
+        })
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub(crate) fn capture_region_raw_into_timed(
+        &mut self,
+        _bounds: (u16, u16, u16, u16),
+        _data: &mut Vec<u8>,
+        _timing: &mut ReadbackTiming,
+    ) -> anyhow::Result<()> {
+        anyhow::bail!("X11 capture not available on this platform")
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    pub(crate) fn capture_into_frame_timed(
+        &mut self,
+        _region: PixelRect,
+        _size: (u16, u16),
+        _frame: &mut [u8],
+        _timing: &mut ReadbackTiming,
+    ) -> anyhow::Result<()> {
+        anyhow::bail!("X11 capture not available on this platform")
+    }
+
+    #[cfg(test)]
+    pub(crate) fn capture_into_frame(
+        &mut self,
+        region: PixelRect,
+        size: (u16, u16),
+        frame: &mut [u8],
+    ) -> anyhow::Result<()> {
+        self.capture_into_frame_timed(region, size, frame, &mut Default::default())
+    }
+}
