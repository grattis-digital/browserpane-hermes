@@ -0,0 +1,18 @@
+/** Local, opt-in presentation invalidation. Never part of the wire protocol. */
+export class PresentationDamage {
+  public static mark(canvas: HTMLCanvasElement | OffscreenCanvas): void {
+    const target = canvas as HTMLCanvasElement | undefined;
+    if (target?.dataset) target.dataset.bpaneRenderer = 'webgl2';
+  }
+
+  public static notify(canvas: HTMLCanvasElement | OffscreenCanvas,
+    x: number, y: number, w: number, h: number,
+    kind: 'tile' | 'video' | 'scroll' | 'reset' = 'tile'): void {
+    const target = canvas as HTMLCanvasElement | undefined;
+    // No event/allocation when the optional local enhancement is off.
+    if (target?.dataset?.bpaneEnhancement !== 'on') return;
+    target.dispatchEvent(new CustomEvent('bpane:presentation-damage', {
+      detail: { x, y, w, h, kind },
+    }));
+  }
+}
