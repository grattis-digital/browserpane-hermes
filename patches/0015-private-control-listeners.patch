+
 fn parse_socket_addr(bind: &str, port: u16, label: &str) -> anyhow::Result<SocketAddr> {
     format!("{bind}:{port}")
         .parse()
         .map_err(|error| anyhow!("invalid {label} address '{bind}:{port}': {error}"))
 }
 
+#[cfg(test)]
+mod listener_tests {
+    use super::gateway_bind_addresses;
+    use crate::config::Config;
+    use clap::Parser;
+
+    #[test]
+    fn omitted_api_bind_preserves_existing_bind_contract() {
+        let config = Config::parse_from(["bpane-gateway", "--bind", "192.0.2.1"]);
+        let (transport, api) = gateway_bind_addresses(&config.gateway).unwrap();
+        assert_eq!(transport.to_string(), "192.0.2.1:4433");
+        assert_eq!(api.to_string(), "192.0.2.1:8932");
+    }
+
+    #[test]
+    fn private_api_bind_does_not_move_public_transport() {
+        let config = Config::parse_from([
+            "bpane-gateway",
+            "--bind",
+            "0.0.0.0",
+            "--api-bind",
+            "127.0.0.1",
+        ]);
+        let (transport, api) = gateway_bind_addresses(&config.gateway).unwrap();
+        assert_eq!(transport.to_string(), "0.0.0.0:4433");
+        assert_eq!(api.to_string(), "127.0.0.1:8932");
+    }
+
+    #[test]
+    fn invalid_api_bind_fails_without_falling_back_to_public() {
+        let config = Config::parse_from(["bpane-gateway", "--api-bind", "not-an-address"]);
+        assert!(gateway_bind_addresses(&config.gateway).is_err());
+    }
+}
