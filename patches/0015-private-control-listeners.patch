+fn gateway_bind_addresses(config: &GatewayConfig) -> anyhow::Result<(SocketAddr, SocketAddr)> {
+    let transport = parse_socket_addr(&config.bind, config.port, "gateway bind")?;
+    let api = parse_socket_addr(
