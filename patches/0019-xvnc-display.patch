+//! Backend selection must never relax the exact virtual capture rectangle.
+
+use super::*;
+use std::ffi::OsStr;
+
+const XVNC_1360: &str = "Screen 0: minimum 32 x 32, current 1360 x 768, maximum 32768 x 32768\nVNC-0 connected 1360x768+0+0 (normal left inverted right x axis y axis) 0mm x 0mm\n   bpane-xvnc-exact-1360x768_60 59.80*\n";
+
+#[test]
+fn xvnc_backend_requires_explicit_exact_opt_in() {
+    assert_eq!(
+        VirtualDisplay::from_setting(None).unwrap(),
+        VirtualDisplay::Dummy
+    );
+    assert_eq!(
+        VirtualDisplay::from_setting(Some(OsStr::new("dummy"))).unwrap(),
+        VirtualDisplay::Dummy
+    );
+    assert_eq!(
+        VirtualDisplay::from_setting(Some(OsStr::new("xvnc"))).unwrap(),
+        VirtualDisplay::Xvnc
+    );
+    for setting in [
+        "", "Xvnc", "x11", "auto", "VNC-0", " xvnc", "xvnc\n", "HDMI-1",
+    ] {
+        assert!(VirtualDisplay::from_setting(Some(OsStr::new(setting))).is_err());
+    }
+}
+
+#[cfg(unix)]
+#[test]
+fn xvnc_backend_rejects_non_unicode_instead_of_defaulting() {
+    use std::os::unix::ffi::OsStrExt;
+
+    assert!(VirtualDisplay::from_setting(Some(OsStr::from_bytes(b"\xff"))).is_err());
+}
+
+#[test]
+fn xvnc_output_and_corrected_mode_namespace_are_backend_specific() {
+    assert_eq!(VirtualDisplay::Dummy.output(), "DUMMY0");
+    assert_eq!(VirtualDisplay::Xvnc.output(), "VNC-0");
+    assert_eq!(
+        VirtualDisplay::Dummy.mode_name(1360, 768),
+        "bpane-exact-1360x768_60"
+    );
+    assert_eq!(
+        VirtualDisplay::Xvnc.mode_name(1360, 768),
+        "bpane-xvnc-exact-1360x768_60"
+    );
+}
+
+#[test]
+fn xvnc_geometry_never_auto_detects_or_accepts_another_backend() {
+    assert_eq!(
+        parse_virtual_display_size(XVNC_1360, VirtualDisplay::Xvnc).unwrap(),
+        (1360, 768)
+    );
+    assert!(parse_virtual_display_size(XVNC_1360, VirtualDisplay::Dummy).is_err());
+    let dummy = XVNC_1360.replace("VNC-0", "DUMMY0");
+    assert!(parse_virtual_display_size(&dummy, VirtualDisplay::Xvnc).is_err());
+    assert_eq!(
+        parse_virtual_display_size(&dummy, VirtualDisplay::Dummy).unwrap(),
+        (1360, 768)
+    );
+}
+
+#[test]
+fn xvnc_geometry_uses_observed_root_and_output_not_libxcvt_mode_names() {
+    let stale = XVNC_1360
+        .replace("current 1360", "current 1366")
+        .replace("1360x768+0+0", "1366x768+0+0");
+    assert_eq!(
+        parse_virtual_display_size(&stale, VirtualDisplay::Xvnc).unwrap(),
+        (1366, 768)
+    );
+    let named_primary = XVNC_1360.replace(" connected ", " connected primary ");
+    assert_eq!(
+        parse_virtual_display_size(&named_primary, VirtualDisplay::Xvnc).unwrap(),
+        (1360, 768)
+    );
+}
+
+#[test]
+fn xvnc_geometry_rejects_offset_multi_output_partial_and_ambiguous_roots() {
+    for output in [
+        String::new(),
+        XVNC_1360.replace("VNC-0 connected", "HDMI-1 connected"),
+        XVNC_1360.replace("VNC-0 connected", "VNC-1 connected"),
+        XVNC_1360.replace("VNC-0 connected", "VNC-0 disconnected"),
+        XVNC_1360.replace("current 1360", "current 1366"),
+        XVNC_1360.replace("1360x768+0+0", "1366x768+0+0"),
+        XVNC_1360.replace("+0+0", "+8+0"),
+        XVNC_1360.replace("+0+0", "-8+0"),
+        XVNC_1360.replace("+0+0", "+0+8"),
+        XVNC_1360.replace("+0+0", "+0-8"),
+        XVNC_1360.replace("1360x768+0+0", ""),
+        XVNC_1360.replace("1360x768+0+0", "0x768+0+0"),
+        XVNC_1360.replace("1360x768+0+0", "1360x768+0+0 1360x768+0+0"),
+        format!("{XVNC_1360}HDMI-1 connected 1360x768+0+0\n"),
+        format!("{XVNC_1360}VNC-1 connected 1360x768+1360+0\n"),
+        format!("{XVNC_1360}DUMMY0 connected 1360x768+0+0\n"),
+        format!("{XVNC_1360}VNC-0 connected 1360x768+0+0\n"),
+        format!("{XVNC_1360}{XVNC_1360}"),
+    ] {
+        assert!(
+            parse_virtual_display_size(&output, VirtualDisplay::Xvnc).is_err(),
+            "{output}"
+        );
+    }
+}
+
+#[test]
+fn xvnc_geometry_allows_inactive_outputs_without_expanding_capture() {
+    let inactive = format!("{XVNC_1360}VNC-1 connected (normal left inverted right x axis y axis)\nHDMI-1 disconnected (normal left inverted right x axis y axis)\n");
+    assert_eq!(
+        parse_virtual_display_size(&inactive, VirtualDisplay::Xvnc).unwrap(),
+        (1360, 768)
+    );
+}
+
+#[test]
+fn xvnc_no_op_resize_still_requires_current_exact_geometry() {
+    let expected = (1360, 768);
+    assert!(!display_resize_needed(expected, expected, || {
+        parse_virtual_display_size(XVNC_1360, VirtualDisplay::Xvnc).ok()
+    }));
+    let partial = XVNC_1360.replace("current 1360", "current 1366");
+    assert!(display_resize_needed(expected, expected, || {
+        parse_virtual_display_size(&partial, VirtualDisplay::Xvnc).ok()
+    }));
+}
