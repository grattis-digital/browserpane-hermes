+/// These are dedicated virtual capture outputs, never physical monitor names.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum VirtualDisplay {
+    Dummy,
+    Xvnc,
+}
+
+impl VirtualDisplay {
+    fn from_setting(setting: Option<&std::ffi::OsStr>) -> anyhow::Result<Self> {
+        match setting {
+            None => Ok(Self::Dummy),
+            Some(value) if value == "dummy" => Ok(Self::Dummy),
+            Some(value) if value == "xvnc" => Ok(Self::Xvnc),
+            Some(_) => anyhow::bail!("BPANE_X11_BACKEND must be dummy or xvnc"),
+        }
+    }
+
+    fn output(self) -> &'static str {
+        match self {
+            Self::Dummy => "DUMMY0",
+            Self::Xvnc => "VNC-0",
+        }
+    }
+
+    fn mode_name(self, w: u32, h: u32) -> String {
+        match self {
+            Self::Dummy => format!("bpane-exact-{w}x{h}_60"),
+            Self::Xvnc => format!("bpane-xvnc-exact-{w}x{h}_60"),
+        }
+    }
+}
+
 fn normalized_resize_dimensions(w: u32, h: u32) -> (u32, u32) {
     ((w.clamp(320, 3840)) & !1, (h.clamp(200, 2160)) & !1)
 }
