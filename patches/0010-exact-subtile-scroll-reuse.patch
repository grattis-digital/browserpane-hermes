+#[cfg(test)]
+mod fractional_tests {
+    use super::*;
+
+    #[test]
+    fn fractional_row_band_fast_path_matches_individual_tile_reference() {
+        let grid = tiles::TileGrid::new(97, 145, 32);
+        let coords: Vec<_> = (0..grid.rows)
+            .flat_map(|row| (0..grid.cols).map(move |col| tiles::TileCoord::new(col, row)))
+            .collect();
+        for padding in [0, 7, 64] {
+            let stride = usize::from(grid.screen_w) * 4 + padding;
+            let previous: Vec<_> = (0..stride * usize::from(grid.screen_h))
+                .map(|index| ((index * 29 + index / 97) % 251) as u8)
+                .collect();
+            for dy in [-65i16, -33, -7, -1, 1, 7, 33, 65] {
+                let mut current = previous.clone();
+                for y in 0..usize::from(grid.screen_h) {
+                    let source = y as i32 + i32::from(dy);
+                    if (0..i32::from(grid.screen_h)).contains(&source) {
+                        current[y * stride..(y + 1) * stride].copy_from_slice(
+                            &previous[source as usize * stride..(source as usize + 1) * stride],
+                        );
+                    }
+                }
+                current[47 * stride + 13 * 4] ^= 19;
+                for (top, bottom) in [(0, 145), (17, 134)] {
+                    for truncated in [false, true] {
+                        let current = if truncated {
+                            &current[..current.len() - 23]
+                        } else {
+                            current.as_slice()
+                        };
+                        let actual = analyze_scroll_residual_in_region(
+                            current, &previous, stride, &grid, 0, dy, &coords, top, bottom,
+                        );
+                        let mut expected = ScrollResidualCoords {
+                            residual: Vec::new(),
+                            exposed_strip: Vec::new(),
+                            residual_area_px: 0,
+                            exposed_strip_area_px: 0,
+                        };
+                        for coord in &coords {
+                            let rect = offset_tile_rect_for_emit(*coord, &grid, 0);
+                            let source_top = i32::from(rect.y) + i32::from(dy);
+                            let source_bottom = source_top + i32::from(rect.h);
+                            if source_top < i32::from(top) || source_bottom > i32::from(bottom) {
+                                expected.residual.push(*coord);
+                                expected.exposed_strip.push(*coord);
+                                let area = usize::from(rect.w) * usize::from(rect.h);
+                                expected.residual_area_px += area;
+                                expected.exposed_strip_area_px += area;
+                            } else {
+                                let diff = summarize_shifted_tile_diff(
+                                    current,
+                                    &previous,
+                                    stride,
+                                    usize::from(grid.screen_h),
+                                    &rect,
+                                    dy,
+                                );
+                                if diff.has_changes() {
+                                    expected.residual.push(*coord);
+                                    expected.residual_area_px +=
+                                        diff.changed_area_px(usize::from(rect.w));
+                                }
+                            }
+                        }
+                        assert_eq!(actual.residual, expected.residual);
+                        assert_eq!(actual.exposed_strip, expected.exposed_strip);
+                        assert_eq!(actual.residual_area_px, expected.residual_area_px);
+                        assert_eq!(actual.exposed_strip_area_px, expected.exposed_strip_area_px);
+                    }
+                }
+            }
+        }
+    }
