+#[test]
+#[ignore]
+fn benchmark_exact_half_tile_copy_against_full_repaint() {
+    use std::time::{Duration, Instant};
+    let grid = TileGrid::new(1280, 720, 64);
+    let stride = usize::from(grid.screen_w) * 4;
+    let coords: Vec<_> = (0..grid.rows)
+        .flat_map(|row| (0..grid.cols).map(move |col| TileCoord::new(col, row)))
+        .collect();
+    let capture = |origin: u16| -> Vec<u8> {
+        (0..grid.screen_h)
+            .flat_map(|y| {
+                (0..grid.screen_w).flat_map(move |x| {
+                    let document_y = y + origin;
+                    let text = document_y % 24 < 12 && x % 200 < 160;
+                    let shade = if text {
+                        (document_y / 24 % 173) as u8
+                    } else {
+                        255
+                    };
+                    [shade, shade, shade, 255]
+                })
+            })
+            .collect()
+    };
+    for round in 0..3 {
+        for allow_half_tile in [false, true] {
+            let mut emitter = TileEmitter::new(grid.cols, grid.rows);
+            let mut viewer = Viewer::new(&grid);
+            let mut previous = capture(0);
+            viewer.apply(
+                emitter
+                    .emit_frame(&previous, stride, &coords, &grid, 0, None, None)
+                    .tile_frames,
+                &grid,
+            );
+            let mut total = Duration::ZERO;
+            let mut total_bytes = 0usize;
+            let mut total_tiles = 0u32;
+            for step in 1..=50 {
+                let current = capture(step * 32);
+                let started = Instant::now();
+                let scroll = DetectedScrollFrame {
+                    dy: 32,
+                    confidence: 1.0,
+                    source: "test",
+                    direction_matches: true,
+                    min_confidence: None,
+                    row_shift: 0,
+                    region_top: 0,
+                    region_bottom: grid.screen_h,
+                    region_right: grid.screen_w,
+                };
+                let partition = partition_and_compare(
+                    &current,
+                    &previous,
+                    stride,
+                    &grid,
+                    0,
+                    64,
+                    if allow_half_tile { 32 } else { 64 },
+                    32,
+                    &coords,
+                    &scroll,
+                    0,
+                    grid.screen_h,
+                    grid.screen_w,
+                    grid.screen_w,
+                );
+                let mut frames = Vec::new();
+                let dirty = if allow_half_tile && partition.saved_tiles > 0 {
+                    emitter.apply_scroll_copy_to_hashes(
+                        &grid,
+                        32,
+                        0,
+                        Rect::new(0, 0, grid.screen_w, grid.screen_h),
+                    );
+                    frames.push(
+                        TileMessage::ScrollCopy {
+                            dx: 0,
+                            dy: 32,
+                            region_top: 0,
+                            region_bottom: grid.screen_h,
+                            region_right: grid.screen_w,
+                        }
+                        .to_frame(),
+                    );
+                    partition
+                        .residual
+                        .into_iter()
+                        .chain(partition.chrome_emit_coords)
+                        .collect::<Vec<_>>()
+                } else {
+                    coords.clone()
+                };
+                let result = emitter.emit_frame(&current, stride, &dirty, &grid, 0, None, None);
+                total_tiles +=
+                    result.stats.fills + result.stats.qoi_tiles + result.stats.cache_hits;
+                frames.extend(result.tile_frames);
+                total += started.elapsed();
+                total_bytes += frames
+                    .iter()
+                    .map(|frame| frame.payload.len())
+                    .sum::<usize>();
+                // Replay/decoding is deliberately outside backend phase time.
+                viewer.apply(frames, &grid);
+                assert!(viewer.pixels == rgba_from_bgra(&current));
+                previous = current;
+            }
+            println!("{{\"round\":{round},\"half_tile_copy\":{allow_half_tile},\"frames\":50,\"host_us\":{},\"tile_commands\":{total_tiles},\"bytes\":{total_bytes}}}", total.as_micros());
+        }
+    }
 }
