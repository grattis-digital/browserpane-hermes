+//! End-to-end host protocol model. Decode emitted tiles and replay exact
+//! clipped ScrollCopy operations, then compare EVERY pixel with fresh capture.
+use std::collections::HashMap;
+
+use bpane_protocol::{frame::Frame, TileMessage};
+
+use crate::scroll::residual::offset_tile_rect_for_emit;
+use crate::scroll::{can_emit_scroll_copy, is_content_tile_in_scroll_region};
+use crate::tiles::{emitter::TileEmitter, Rect, TileCoord, TileGrid};
+
+use super::frame_types::DetectedScrollFrame;
+use super::scroll_partition::partition_and_compare;
+
+struct Viewer {
+    pixels: Vec<u8>,
+    cache: HashMap<u64, Vec<u8>>,
+    offset: u16,
+    apply_offset: bool,
+}
+
+impl Viewer {
+    fn new(grid: &TileGrid) -> Self {
+        Self {
+            pixels: vec![0; usize::from(grid.screen_w) * usize::from(grid.screen_h) * 4],
+            cache: HashMap::new(),
+            offset: 0,
+            apply_offset: true,
+        }
+    }
+
+    fn paint(&mut self, rect: Rect, bytes: &[u8], grid: &TileGrid) {
+        assert_eq!(bytes.len(), usize::from(rect.w) * usize::from(rect.h) * 4);
+        let stride = usize::from(grid.screen_w) * 4;
+        let row_bytes = usize::from(rect.w) * 4;
+        for row in 0..usize::from(rect.h) {
+            let start = (usize::from(rect.y) + row) * stride + usize::from(rect.x) * 4;
+            self.pixels[start..start + row_bytes]
+                .copy_from_slice(&bytes[row * row_bytes..(row + 1) * row_bytes]);
+        }
+    }
+
+    fn apply(&mut self, frames: impl IntoIterator<Item = Frame>, grid: &TileGrid) {
+        for frame in frames {
+            match TileMessage::decode(&frame.payload).unwrap() {
+                TileMessage::GridConfig { .. } => {
+                    self.cache.clear();
+                    self.pixels.fill(0);
+                }
+                TileMessage::GridOffset { offset_y, .. } => self.offset = offset_y as u16,
+                TileMessage::TileDrawMode { apply_offset } => self.apply_offset = apply_offset,
+                TileMessage::Fill { col, row, rgba } => {
+                    let rect = offset_tile_rect_for_emit(
+                        TileCoord::new(col, row),
+                        grid,
+                        if self.apply_offset { self.offset } else { 0 },
+                    );
+                    self.paint(
+                        rect,
+                        &rgba
+                            .to_le_bytes()
+                            .repeat(usize::from(rect.w) * usize::from(rect.h)),
+                        grid,
+                    );
+                }
+                TileMessage::Qoi {
+                    col,
+                    row,
+                    hash,
+                    data,
+                } => {
+                    let (header, bytes) = qoi::decode_to_vec(&data).unwrap();
+                    let rect = offset_tile_rect_for_emit(
+                        TileCoord::new(col, row),
+                        grid,
+                        if self.apply_offset { self.offset } else { 0 },
+                    );
+                    assert_eq!(
+                        (header.width, header.height),
+                        (u32::from(rect.w), u32::from(rect.h))
+                    );
+                    self.paint(rect, &bytes, grid);
+                    if hash != 0 {
+                        self.cache.insert(hash, bytes);
+                    }
+                }
+                TileMessage::CacheHit { col, row, hash } => {
+                    let bytes = self
+                        .cache
+                        .get(&hash)
+                        .expect("sender referenced absent cache tile")
+                        .clone();
+                    let rect = offset_tile_rect_for_emit(
+                        TileCoord::new(col, row),
+                        grid,
+                        if self.apply_offset { self.offset } else { 0 },
+                    );
+                    self.paint(rect, &bytes, grid);
+                }
+                TileMessage::ScrollCopy {
+                    dy,
+                    region_top,
+                    region_bottom,
+                    region_right,
+                    ..
+                } => {
+                    let previous = self.pixels.clone();
+                    let stride = usize::from(grid.screen_w) * 4;
+                    for y in region_top..region_bottom {
+                        let source = i32::from(y) + i32::from(dy);
+                        for x in 0..region_right {
+                            let dest = usize::from(y) * stride + usize::from(x) * 4;
+                            if source >= i32::from(region_top) && source < i32::from(region_bottom)
+                            {
+                                let src = source as usize * stride + usize::from(x) * 4;
+                                self.pixels[dest..dest + 4]
+                                    .copy_from_slice(&previous[src..src + 4]);
+                            } else {
+                                // Exposed pixels are undefined: neither white
+                                // nor old framebuffer content is safe to trust.
+                                self.pixels[dest..dest + 4].copy_from_slice(&[251, 2, 217, 255]);
+                            }
+                        }
+                    }
+                }
+                TileMessage::BatchEnd { .. } | TileMessage::VideoRegion { .. } => {}
+                other => panic!("unexpected test command: {other:?}"),
+            }
+        }
+    }
+}
+
+fn rgba_from_bgra(bytes: &[u8]) -> Vec<u8> {
+    bytes
+        .chunks_exact(4)
+        .flat_map(|p| [p[2], p[1], p[0], p[3]])
+        .collect()
+}
+
+#[test]
+fn random_scroll_reversals_reconstruct_every_pixel_with_matching_chrome_and_offset_edges() {
+    let grid = TileGrid::new(193, 323, 64);
+    let stride = usize::from(grid.screen_w) * 4;
+    let mut random = 0x1234_5678_u32;
+    for (top, bottom, right, offset) in [
+        (64, 256, 192, 0),
+        (85, 289, 177, 0),
+        (0, 323, 193, 17),
+        (0, 323, 193, 63),
+    ] {
+        let coords: Vec<_> = (0..grid.rows + u16::from(offset > 0))
+            .flat_map(|row| (0..grid.cols).map(move |col| TileCoord::new(col, row)))
+            .collect();
+        let mut previous = vec![255u8; stride * usize::from(grid.screen_h)];
+        for y in top..bottom {
+            for x in 0..right {
+                let index = usize::from(y) * stride + usize::from(x) * 4;
+                previous[index..index + 4].copy_from_slice(&[x as u8, y as u8, (x ^ y) as u8, 255]);
+            }
+        }
+        let mut emitter = TileEmitter::new(grid.cols, grid.rows);
+        let mut viewer = Viewer::new(&grid);
+        viewer.offset = offset;
+        viewer.apply(
+            emitter
+                .emit_frame(&previous, stride, &coords, &grid, offset, None, None)
+                .tile_frames,
+            &grid,
+        );
+        let mut copy_count = 0;
+        for step in 0..80 {
+            random ^= random << 13;
+            random ^= random >> 17;
+            random ^= random << 5;
+            let dy = [64i16, -64, 128, -128, 7, -7, 1, -1][random as usize % 8];
+            let mut current = previous.clone();
+            for y in top..bottom {
+                for x in 0..right {
+                    let index = usize::from(y) * stride + usize::from(x) * 4;
+                    let source = i32::from(y) + i32::from(dy);
+                    if source >= i32::from(top) && source < i32::from(bottom) {
+                        let src = source as usize * stride + usize::from(x) * 4;
+                        current[index..index + 4].copy_from_slice(&previous[src..src + 4]);
+                    } else {
+                        current[index..index + 4].fill(255); // matches exterior chrome
+                    }
+                    // Sparse real changes exercise residuals/cache reuse,
+                    // rather than degenerating into a permanently blank page.
+                    if step % 3 == 0
+                        && u32::from(x) == random % u32::from(right)
+                        && u32::from(y) == u32::from(top) + (random / 17) % u32::from(bottom - top)
+                    {
+                        current[index..index + 4].copy_from_slice(&[step, x as u8, y as u8, 255]);
+                    }
+                }
+            }
+            let scroll = DetectedScrollFrame {
+                dy,
+                confidence: 1.0,
+                source: "test",
+                direction_matches: true,
+                min_confidence: None,
+                row_shift: if dy % 64 == 0 { i32::from(dy) / 64 } else { 0 },
+                region_top: top,
+                region_bottom: bottom,
+                region_right: right,
+            };
+            let partition = partition_and_compare(
+                &current,
+                &previous,
+                stride,
+                &grid,
+                offset,
+                64,
+                64,
+                dy,
+                &coords,
+                &scroll,
+                top,
+                grid.screen_h,
+                right,
+                grid.screen_w,
+            );
+            let copy = can_emit_scroll_copy(dy, 64, 64) && partition.saved_tiles > 0;
+            let dirty = if copy {
+                copy_count += 1;
+                emitter.shift_hashes(scroll.row_shift, grid.rows);
+                emitter.zero_exposed_strip(dy, top, bottom, 64, offset);
+                viewer.apply(
+                    [TileMessage::ScrollCopy {
+                        dx: 0,
+                        dy,
+                        region_top: top,
+                        region_bottom: bottom,
+                        region_right: right,
+                    }
+                    .to_frame()],
+                    &grid,
+                );
+                partition
+                    .residual
+                    .into_iter()
+                    .chain(partition.chrome_emit_coords)
+                    .collect::<Vec<_>>()
+            } else {
+                coords.clone()
+            };
+            // Nonzero-offset cases use a single full-screen content grid;
+            // zero-offset cases exercise actual mixed chrome/content emission.
+            let (content, chrome): (Vec<_>, Vec<_>) = dirty.into_iter().partition(|coord| {
+                offset > 0 || is_content_tile_in_scroll_region(*coord, 64, top, bottom, right)
+            });
+            viewer.apply(
+                emitter
+                    .emit_frame(&current, stride, &content, &grid, offset, None, None)
+                    .tile_frames,
+                &grid,
+            );
+            if !chrome.is_empty() {
+                viewer.apply(
+                    [TileMessage::TileDrawMode {
+                        apply_offset: false,
+                    }
+                    .to_frame()],
+                    &grid,
+                );
+                viewer.apply(
+                    emitter.emit_static_tiles(
+                        &current,
+                        stride,
+                        &chrome,
+                        &grid,
+                        (right % 64 != 0).then_some(right / 64),
+                        (top % 64 != 0).then_some(top / 64),
+                        (bottom % 64 != 0).then_some(bottom / 64),
+                        None,
+                        None,
+                    ),
+                    &grid,
+                );
+                viewer.apply(
+                    [TileMessage::TileDrawMode { apply_offset: true }.to_frame()],
+                    &grid,
+                );
+            }
+            let expected = rgba_from_bgra(&current);
+            assert!(viewer.pixels == expected, "pixel mismatch: region={top}..{bottom}/{right}, offset={offset}, step={step}, dy={dy}, copy={copy}; first={:?}",
+                viewer.pixels.iter().zip(&expected).position(|(a,b)| a != b));
+            previous = current;
+        }
+        assert!(
+            copy_count >= 10,
+            "model must exercise retained ScrollCopy, not only fallbacks"
+        );
+    }
+}
+
+#[test]
+fn delayed_cache_miss_recovers_moved_holes_with_one_fresh_snapshot() {
+    let grid = TileGrid::new(128, 145, 64);
+    let coords: Vec<_> = (0..grid.rows + 1)
+        .flat_map(|row| (0..grid.cols).map(move |col| TileCoord::new(col, row)))
+        .collect();
+    let pixels: Vec<_> = (0..145u16)
+        .flat_map(|y| (0..128u16).flat_map(move |x| [x as u8, y as u8, (x ^ y) as u8, 255]))
+        .collect();
+    let mut emitter = TileEmitter::new(grid.cols, grid.rows);
+    let mut viewer = Viewer::new(&grid);
+    viewer.offset = 17;
+    viewer.apply(
+        emitter
+            .emit_frame(&pixels, 512, &coords, &grid, 17, None, None)
+            .tile_frames,
+        &grid,
+    );
+    let missing_hash = *viewer.cache.keys().next().unwrap();
+    viewer.cache.clear();
+    viewer.pixels[..64 * 4].fill(0);
+    // The missing pixels move before the old-coordinate report reaches host.
+    viewer.apply(
+        [TileMessage::ScrollCopy {
+            dx: 0,
+            dy: -64,
+            region_top: 0,
+            region_bottom: 145,
+            region_right: 128,
+        }
+        .to_frame()],
+        &grid,
+    );
+    emitter.handle_cache_miss(0, 0, missing_hash);
+    emitter.handle_cache_miss(1, 1, missing_hash);
+    let prefix = emitter
+        .begin_requested_snapshot(&grid, 17)
+        .expect("desync requires snapshot");
+    viewer.apply(prefix, &grid);
+    let repaired = emitter.emit_frame(&pixels, 512, &coords, &grid, 17, None, None);
+    assert_eq!(repaired.stats.cache_hits, 0);
+    viewer.apply(repaired.tile_frames, &grid);
+    assert_eq!(viewer.pixels, rgba_from_bgra(&pixels));
+    assert!(
+        emitter.begin_requested_snapshot(&grid, 17).is_none(),
+        "reports must coalesce"
+    );
+}
