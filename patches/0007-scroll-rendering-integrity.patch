+#[cfg(test)]
+mod integrity_tests {
+    use super::*;
+
+    #[test]
+    fn exposed_viewport_tiles_are_repaired_even_when_matching_outside_chrome() {
+        let grid = tiles::TileGrid::new(128, 320, 64);
+        let stride = 128 * 4;
+        let coords: Vec<_> = (0..grid.rows)
+            .flat_map(|row| (0..grid.cols).map(move |col| tiles::TileCoord::new(col, row)))
+            .collect();
+        for (top, bottom) in [(64, 256), (80, 271)] {
+            for dy in [-128i16, -64, 64, 128] {
+                let mut previous = vec![255u8; stride * 320];
+                for y in top..bottom {
+                    previous[y as usize * stride..(y as usize + 1) * stride].fill(y as u8);
+                }
+                let mut current = previous.clone();
+                for y in top..bottom {
+                    let source = i32::from(y) + i32::from(dy);
+                    let row = &mut current[y as usize * stride..(y as usize + 1) * stride];
+                    if source >= i32::from(top) && source < i32::from(bottom) {
+                        row.copy_from_slice(
+                            &previous[source as usize * stride..(source as usize + 1) * stride],
+                        );
+                    } else {
+                        row.fill(255); // same as chrome, but NOT copied by the client
+                    }
+                }
+                let scroll = DetectedScrollFrame {
+                    dy,
+                    confidence: 1.0,
+                    source: "test",
+                    direction_matches: true,
+                    min_confidence: None,
+                    row_shift: i32::from(dy) / 64,
+                    region_top: top,
+                    region_bottom: bottom,
+                    region_right: 128,
+                };
+                let result = partition_and_compare(
+                    &current, &previous, stride, &grid, 0, 64, 64, dy, &coords, &scroll, top, 320,
+                    128, 128,
+                );
+                for coord in &coords {
+                    if !is_content_tile_in_scroll_region(*coord, 64, top, bottom, 128) {
+                        continue;
+                    }
+                    let source_top = i32::from(coord.row) * 64 + i32::from(dy);
+                    if source_top < i32::from(top) || source_top + 64 > i32::from(bottom) {
+                        assert!(
+                            result.residual.contains(coord)
+                                || result.chrome_emit_coords.contains(coord),
+                            "exposed tile {coord:?} omitted for dy={dy}, region={top}..{bottom}"
+                        );
+                    }
+                }
+            }
+        }
     }
 }
