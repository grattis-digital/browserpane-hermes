diff --git a/code/web/bpane-client/js/render/webgl-tile-texture-cache.ts b/code/web/bpane-client/js/render/webgl-tile-texture-cache.ts
new file mode 100644
index 0000000..d851d8b
--- /dev/null
+++ b/code/web/bpane-client/js/render/webgl-tile-texture-cache.ts
@@ -0,0 +1,73 @@
+import type { CachedTile } from '../tile-cache.js';
+
+type TextureEntry = { texture: WebGLTexture; bytes: number };
+
+/**
+ * Bounded GPU mirror of immutable decoded tiles. Object identity deliberately
+ * distinguishes replacements for the same wire hash. Mutable video/canvas
+ * sources never enter this cache. CPU and GPU cache eviction are independent;
+ * a GPU miss only reuploads pixels and never causes a protocol cache miss.
+ */
+export class WebGLTileTextureCache {
+  private readonly entries = new Map<CachedTile, TextureEntry>();
+  private byteSize = 0;
+  readonly stats = { hits: 0, uploads: 0, evictions: 0 };
+
+  constructor(
+    private readonly gl: WebGL2RenderingContext,
+    private readonly maxEntries = 2048,
+    private readonly maxBytes = 32 * 1024 * 1024,
+  ) {}
+
+  get bytes(): number { return this.byteSize; }
+  get size(): number { return this.entries.size; }
+
+  getOrUpload(tile: CachedTile): WebGLTexture | null {
+    const existing = this.entries.get(tile);
+    if (existing) {
+      this.entries.delete(tile);
+      this.entries.set(tile, existing);
+      this.stats.hits++;
+      return existing.texture;
+    }
+
+    const bytes = tile.width * tile.height * 4;
+    if (bytes <= 0 || !Number.isSafeInteger(bytes) || bytes > this.maxBytes || this.maxEntries <= 0) {
+      return null;
+    }
+    const gl = this.gl;
+    const texture = gl.createTexture();
+    if (!texture) return null;
+
+    while (this.entries.size >= this.maxEntries || this.byteSize + bytes > this.maxBytes) {
+      const oldest = this.entries.entries().next().value;
+      if (!oldest) break;
+      this.entries.delete(oldest[0]);
+      this.byteSize -= oldest[1].bytes;
+      gl.deleteTexture(oldest[1].texture);
+      this.stats.evictions++;
+    }
+
+    try {
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, tile);
+    } catch (error) {
+      gl.deleteTexture(texture);
+      throw error;
+    }
+    this.entries.set(tile, { texture, bytes });
+    this.byteSize += bytes;
+    this.stats.uploads++;
+    return texture;
+  }
+
+  clear(): void {
+    for (const entry of this.entries.values()) this.gl.deleteTexture(entry.texture);
+    this.entries.clear();
+    this.byteSize = 0;
+  }
+}
