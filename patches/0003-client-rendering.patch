diff --git a/code/web/bpane-client/js/__tests__/webgl-tile-texture-cache.test.ts b/code/web/bpane-client/js/__tests__/webgl-tile-texture-cache.test.ts
new file mode 100644
index 0000000..b14fb4b
--- /dev/null
+++ b/code/web/bpane-client/js/__tests__/webgl-tile-texture-cache.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, it, vi } from 'vitest';
+import { WebGLTileTextureCache } from '../render/webgl-tile-texture-cache.js';
+
+function createGl() {
+  let id = 0;
+  return {
+    TEXTURE_2D: 1, TEXTURE_MIN_FILTER: 2, TEXTURE_MAG_FILTER: 3,
+    TEXTURE_WRAP_S: 4, TEXTURE_WRAP_T: 5, NEAREST: 6,
+    CLAMP_TO_EDGE: 7, RGBA: 8, UNSIGNED_BYTE: 9,
+    createTexture: vi.fn(() => ({ id: ++id })),
+    deleteTexture: vi.fn(), bindTexture: vi.fn(), texParameteri: vi.fn(), texImage2D: vi.fn(),
+  } as unknown as WebGL2RenderingContext;
+}
+
+function tile(width = 2, height = 2): ImageData {
+  return { width, height, data: new Uint8ClampedArray(width * height * 4) } as ImageData;
+}
+
+describe('WebGLTileTextureCache', () => {
+  it('uploads once and reuses immutable source identity at every position', () => {
+    const gl = createGl();
+    const cache = new WebGLTileTextureCache(gl);
+    const source = tile();
+    const texture = cache.getOrUpload(source);
+    expect(cache.getOrUpload(source)).toBe(texture);
+    expect(gl.texImage2D).toHaveBeenCalledTimes(1);
+    expect(cache.stats).toEqual({ hits: 1, uploads: 1, evictions: 0 });
+  });
+
+  it('distinguishes replacements and evicts least-recently-used textures', () => {
+    const gl = createGl();
+    const cache = new WebGLTileTextureCache(gl, 2, 100);
+    const first = tile();
+    const second = tile();
+    const third = tile();
+    cache.getOrUpload(first);
+    const oldTexture = cache.getOrUpload(second);
+    cache.getOrUpload(first);
+    cache.getOrUpload(third);
+    expect(gl.texImage2D).toHaveBeenCalledTimes(3);
+    expect(gl.deleteTexture).toHaveBeenCalledWith(oldTexture);
+    expect(cache.size).toBe(2);
+    expect(cache.stats.evictions).toBe(1);
+  });
+
+  it('reserves incoming bytes, keeps exact fits and rejects oversized sources', () => {
+    const gl = createGl();
+    const cache = new WebGLTileTextureCache(gl, 10, 20);
+    cache.getOrUpload(tile(1, 1));
+    cache.getOrUpload(tile(2, 2));
+    expect(cache.bytes).toBe(20);
+    cache.getOrUpload(tile(2, 1));
+    expect(cache.bytes).toBe(8);
+    expect(cache.stats.evictions).toBe(2);
+    expect(cache.getOrUpload(tile(3, 3))).toBeNull();
+    expect(cache.bytes).toBe(8);
+  });
+
+  it('deletes all textures exactly once on clear and reuploads on reuse', () => {
+    const gl = createGl();
+    const cache = new WebGLTileTextureCache(gl);
+    const source = tile();
+    const texture = cache.getOrUpload(source);
+    cache.clear();
+    cache.clear();
+    expect(gl.deleteTexture).toHaveBeenCalledTimes(1);
+    expect(gl.deleteTexture).toHaveBeenCalledWith(texture);
+    expect(cache.bytes).toBe(0);
+    expect(cache.size).toBe(0);
+    cache.getOrUpload(source);
+    expect(gl.texImage2D).toHaveBeenCalledTimes(2);
+  });
+
+  it('handles allocation failure and deletes resources after an upload exception', () => {
+    const gl = createGl();
+    const cache = new WebGLTileTextureCache(gl);
+    vi.mocked(gl.createTexture).mockReturnValueOnce(null);
+    expect(cache.getOrUpload(tile())).toBeNull();
+    vi.mocked(gl.texImage2D).mockImplementationOnce(() => { throw new Error('lost'); });
+    expect(() => cache.getOrUpload(tile())).toThrow('lost');
+    expect(gl.deleteTexture).toHaveBeenCalledTimes(1);
+    expect(cache.size).toBe(0);
+    expect(cache.bytes).toBe(0);
+  });
+
+  it('does not share textures between WebGL contexts', () => {
+    const source = tile();
+    const firstGl = createGl();
+    const secondGl = createGl();
+    new WebGLTileTextureCache(firstGl).getOrUpload(source);
+    new WebGLTileTextureCache(secondGl).getOrUpload(source);
+    expect(firstGl.texImage2D).toHaveBeenCalledTimes(1);
+    expect(secondGl.texImage2D).toHaveBeenCalledTimes(1);
+  });
+});
