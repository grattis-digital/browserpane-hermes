+use super::*;
+use tokio::sync::oneshot;
+
+#[tokio::test]
+async fn video_flows_while_a_tile_write_is_blocked() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    lanes.reliable(Bytes::from_static(b"tile"), false).unwrap();
+    let (started, ready) = oneshot::channel();
+    let (release, unblock) = oneshot::channel::<()>();
+    let mut started = Some(started);
+    let mut unblock = Some(unblock);
+    let writer = tokio::spawn(reliable.run(move |_| {
+        started.take().unwrap().send(()).unwrap();
+        let wait = unblock.take().unwrap();
+        async move { wait.await.map_err(|_| ()) }
+    }));
+    ready.await.unwrap();
+    let (sent, received) = oneshot::channel();
+    let mut sent = Some(sent);
+    let datagrams = tokio::spawn(video.run(move |bytes| {
+        assert_eq!(bytes, b"delta");
+        sent.take().unwrap().send(()).unwrap();
+    }));
+    lanes.datagram(Bytes::from_static(b"delta")).unwrap();
+    tokio::time::timeout(std::time::Duration::from_secs(1), received)
+        .await
+        .unwrap()
+        .unwrap();
+    release.send(()).unwrap();
+    drop(lanes);
+    writer.await.unwrap().unwrap();
+    datagrams.await.unwrap().unwrap();
+}
+
+#[tokio::test]
+async fn delta_waits_for_its_keyframe_but_not_the_following_tile() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    lanes.reliable(Bytes::from_static(b"sps"), true).unwrap();
+    lanes.reliable(Bytes::from_static(b"idr"), true).unwrap();
+    lanes.reliable(Bytes::from_static(b"tile"), false).unwrap();
+    lanes.datagram(Bytes::from_static(b"delta")).unwrap();
+    let (sent, mut received) = mpsc::unbounded_channel();
+    let datagrams = tokio::spawn(video.run(move |bytes| {
+        sent.send(bytes.to_vec()).unwrap();
+    }));
+    tokio::task::yield_now().await;
+    assert!(received.try_recv().is_err());
+    let (tile_started, ready) = oneshot::channel();
+    let mut tile_started = Some(tile_started);
+    let writer = tokio::spawn(reliable.run(move |bytes| {
+        let signal = if bytes == b"tile"[..] {
+            tile_started.take()
+        } else {
+            None
+        };
+        async move {
+            if let Some(signal) = signal {
+                signal.send(()).unwrap();
+                std::future::pending::<()>().await;
+            }
+            Ok(())
+        }
+    }));
+    ready.await.unwrap();
+    assert_eq!(
+        tokio::time::timeout(std::time::Duration::from_secs(1), received.recv())
+            .await
+            .unwrap()
+            .unwrap(),
+        b"delta"
+    );
+    writer.abort();
+    drop(lanes);
+    datagrams.await.unwrap().unwrap();
+}
+
+#[tokio::test]
+async fn reliable_order_and_inflight_byte_budget_are_preserved() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    for value in [b"grid".as_slice(), b"region", b"tile", b"ack"] {
+        lanes
+            .reliable(Bytes::copy_from_slice(value), false)
+            .unwrap();
+    }
+    let mut seen = Vec::new();
+    drop(video);
+    let budget = lanes.budget.clone();
+    drop(lanes);
+    reliable
+        .run(|bytes| {
+            seen.push(bytes);
+            async { Ok(()) }
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        seen.iter().map(|b| b.as_ref()).collect::<Vec<_>>(),
+        vec![b"grid".as_slice(), b"region", b"tile", b"ack"]
+    );
+    assert_eq!(budget.available_permits(), BYTE_LIMIT);
+}
+
+#[test]
+fn overflow_is_explicit_and_cancellation_releases_every_permit() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    for _ in 0..RELIABLE_PACKETS {
+        lanes.reliable(Bytes::from_static(b"x"), false).unwrap();
+    }
+    assert!(lanes.reliable(Bytes::from_static(b"x"), false).is_err());
+    for _ in 0..VIDEO_PACKETS {
+        lanes.datagram(Bytes::from_static(b"y")).unwrap();
+    }
+    assert!(lanes.datagram(Bytes::from_static(b"y")).is_err());
+    drop(reliable);
+    drop(video);
+    assert_eq!(lanes.budget.available_permits(), BYTE_LIMIT);
+    let (mut lanes, reliable, _) = EgressLanes::new();
+    lanes
+        .reliable(Bytes::from(vec![0; BYTE_LIMIT]), false)
+        .unwrap();
+    assert!(lanes.datagram(Bytes::from_static(b"x")).is_err());
+    drop(reliable);
+    assert_eq!(lanes.budget.available_permits(), BYTE_LIMIT);
+}
+
+#[tokio::test]
+async fn failed_keyframe_never_releases_dependent_deltas() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    lanes.reliable(Bytes::from_static(b"idr"), true).unwrap();
+    lanes.datagram(Bytes::from_static(b"delta")).unwrap();
+    assert!(reliable.run(|_| async { Err(()) }).await.is_err());
+    assert!(video
+        .run(|_| panic!("delta escaped failed keyframe"))
+        .await
+        .is_err());
+}
