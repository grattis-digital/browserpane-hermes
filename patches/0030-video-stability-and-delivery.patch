+//! Bounded delivery lanes. Slow reliable writes must not stop video datagrams.
+//! All reliable bytes retain order; video waits for its preceding codec/IDR
+//! writes, not unrelated tiles. Overflow fails the viewer closed, never drops
+//! a dependent tile or a random H.264 delta and continues with corrupt history.
+use bytes::Bytes;
+use std::{future::Future, sync::Arc};
+use tokio::sync::{mpsc, watch, OwnedSemaphorePermit, Semaphore};
+
+const BYTE_LIMIT: usize = 16 * 1024 * 1024 + 5; // one maximum legal wire frame
+const RELIABLE_PACKETS: usize = 512;
+const VIDEO_PACKETS: usize = 256;
+
+struct Packet {
+    bytes: Bytes,
+    barrier: u64,
+    _permit: OwnedSemaphorePermit,
+}
+
+pub(super) struct EgressLanes {
+    reliable: mpsc::Sender<Packet>,
+    video: mpsc::Sender<Packet>,
+    budget: Arc<Semaphore>,
+    barrier: u64,
+}
+
+pub(super) struct ReliableLane {
+    input: mpsc::Receiver<Packet>,
+    completed: watch::Sender<u64>,
+}
+
+pub(super) struct VideoLane {
+    input: mpsc::Receiver<Packet>,
+    completed: watch::Receiver<u64>,
+}
+
+impl EgressLanes {
+    pub fn new() -> (Self, ReliableLane, VideoLane) {
+        let (reliable, reliable_rx) = mpsc::channel(RELIABLE_PACKETS);
+        let (video, video_rx) = mpsc::channel(VIDEO_PACKETS);
+        let (completed, completed_rx) = watch::channel(0);
+        (
+            Self {
+                reliable,
+                video,
+                budget: Arc::new(Semaphore::new(BYTE_LIMIT)),
+                barrier: 0,
+            },
+            ReliableLane {
+                input: reliable_rx,
+                completed,
+            },
+            VideoLane {
+                input: video_rx,
+                completed: completed_rx,
+            },
+        )
+    }
+
+    fn packet(&self, bytes: Bytes, barrier: u64) -> Result<Packet, ()> {
+        let count = u32::try_from(bytes.len()).map_err(|_| ())?;
+        let permit = self
+            .budget
+            .clone()
+            .try_acquire_many_owned(count)
+            .map_err(|_| ())?;
+        Ok(Packet {
+            bytes,
+            barrier,
+            _permit: permit,
+        })
+    }
+
+    pub fn reliable(&mut self, bytes: Bytes, video_key: bool) -> Result<(), ()> {
+        let barrier = if video_key {
+            self.barrier.checked_add(1).ok_or(())?
+        } else {
+            0
+        };
+        let packet = self.packet(bytes, barrier)?;
+        self.reliable.try_send(packet).map_err(|_| ())?;
+        if video_key {
+            self.barrier = barrier;
+        }
+        Ok(())
+    }
+
+    pub fn datagram(&self, bytes: Bytes) -> Result<(), ()> {
+        let packet = self.packet(bytes, self.barrier)?;
+        self.video.try_send(packet).map_err(|_| ())
+    }
+}
+
+impl ReliableLane {
+    pub async fn run<F, W>(mut self, mut write: F) -> Result<(), ()>
+    where
+        F: FnMut(Bytes) -> W,
+        W: Future<Output = Result<(), ()>>,
+    {
+        while let Some(packet) = self.input.recv().await {
+            write(packet.bytes).await?;
+            if packet.barrier != 0 {
+                self.completed.send_replace(packet.barrier);
+            }
+            // The permit covers the in-flight write as well as queued bytes.
+        }
+        Ok(())
+    }
+}
+
+impl VideoLane {
+    pub async fn run<F>(mut self, mut send: F) -> Result<(), ()>
+    where
+        F: FnMut(&[u8]),
+    {
+        while let Some(packet) = self.input.recv().await {
+            while *self.completed.borrow_and_update() < packet.barrier {
+                self.completed.changed().await.map_err(|_| ())?;
+            }
+            send(&packet.bytes);
+        }
+        Ok(())
+    }
+}
