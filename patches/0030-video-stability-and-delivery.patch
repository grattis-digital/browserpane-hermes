+//! Private scripted CDP peer. No browser, profile, GPU or real sleep required.
+use super::*;
+use tokio::net::TcpListener;
+
+async fn exchange(late: bool, empty: bool) -> (Option<PageHintState>, u64) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let peer = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(socket).await.unwrap();
+        let first: Value =
+            serde_json::from_str(ws.next().await.unwrap().unwrap().to_text().unwrap()).unwrap();
+        let request = if late {
+            // Withhold the first reply until the retry arrives. No wall-clock
+            // pacing; the client deadline drives this deterministic exchange.
+            let second: Value =
+                serde_json::from_str(ws.next().await.unwrap().unwrap().to_text().unwrap()).unwrap();
+            ws.send(Message::Text(
+                json!({"id": first["id"], "result": {"result": {"value": null}}})
+                    .to_string()
+                    .into(),
+            ))
+            .await
+            .unwrap();
+            second
+        } else {
+            first
+        };
+        let value = if empty {
+            Value::Null
+        } else {
+            json!({
+                "visible": true, "focused": true, "regionKind": "video",
+                "region": {"x": 12, "y": 20, "w": 640, "h": 360}
+            })
+        };
+        ws.send(Message::Text(
+            json!({"id": request["id"], "result": {"result": {"value": value}}})
+                .to_string()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        // A third request is a bug: retry is strictly bounded.
+        while let Some(message) = ws.next().await {
+            if message.unwrap().is_close() {
+                break;
+            }
+            panic!("unexpected extra probe");
+        }
+    });
+    let (mut ws, _) = connect_async(format!("ws://{address}")).await.unwrap();
+    let mut id = 1;
+    let hint = evaluate_page_hint_with_retry(&mut ws, "null", &mut id).await;
+    ws.close(None).await.unwrap();
+    peer.await.unwrap();
+    (hint, id)
+}
+
+#[tokio::test]
+async fn late_reply_cannot_revoke_the_fresh_retry() {
+    let (hint, next) = tokio::time::timeout(Duration::from_secs(3), exchange(true, false))
+        .await
+        .unwrap();
+    assert_eq!(next, 3);
+    assert_eq!(hint.unwrap().video_region.unwrap().w, 640);
+}
+
+#[tokio::test]
+async fn explicit_exit_is_not_retried_or_held() {
+    let (hint, next) = tokio::time::timeout(Duration::from_secs(3), exchange(false, true))
+        .await
+        .unwrap();
+    assert_eq!(next, 2);
+    assert!(!hint.unwrap().visible);
+}
