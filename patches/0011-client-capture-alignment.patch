+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { SessionResizeRuntime } from '../session-resize-runtime.js';
+import { PointerInputRuntime } from '../input/pointer-input-runtime.js';
+
+function fixture(overrides: Partial<ConstructorParameters<typeof SessionResizeRuntime>[0]> = {}) {
+  const container = document.createElement('div');
+  container.style.cssText = 'flex:1;min-height:0;overflow:hidden';
+  const canvas = document.createElement('canvas');
+  const cursorEl = document.createElement('canvas');
+  for (const child of [canvas, cursorEl]) {
+    child.style.width = '100%'; child.style.height = '100%';
+    container.appendChild(child);
+  }
+  let width = 1366;
+  let height = 769;
+  const rect = (w: number, h: number) => ({ x: 10, y: 51, left: 10, top: 51,
+    width: w, height: h, right: 10 + w, bottom: 51 + h, toJSON() {} });
+  container.getBoundingClientRect = () => rect(width, height);
+  canvas.getBoundingClientRect = () => rect(
+    canvas.style.width.endsWith('px') ? parseFloat(canvas.style.width) : width,
+    canvas.style.height.endsWith('px') ? parseFloat(canvas.style.height) : height,
+  );
+  const sendResizeRequest = vi.fn();
+  const resizeObserver = { observe: vi.fn(), disconnect: vi.fn() };
+  const runtime = new SessionResizeRuntime({
+    container, canvas, cursorEl, hiDpi: false, resizeSource: 'container',
+    resizeAlignment: { width: 8, height: 2 }, resizeObserver,
+    resizeRenderer: vi.fn(), markDisplayDirty: vi.fn(), sendResizeRequest,
+    setRemoteSize: vi.fn(), getDevicePixelRatio: () => 2,
+    ...overrides,
+  });
+  return { runtime, container, canvas, cursorEl, sendResizeRequest, resizeObserver,
+    setSize(w: number, h: number) { width = w; height = h; } };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe('opt-in physical capture alignment', () => {
+  it('fits odd dimensions to X11/CVT and H.264 without stretching or changing parent layout', () => {
+    const { runtime, container, canvas, cursorEl } = fixture();
+    const containerStyle = container.style.cssText;
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 1360, height: 768 });
+    expect([canvas.width, canvas.height, cursorEl.width, cursorEl.height]).toEqual([1360, 768, 1360, 768]);
+    expect([canvas.style.width, canvas.style.height]).toEqual(['1360px', '768px']);
+    expect([cursorEl.style.width, cursorEl.style.height]).toEqual(['1360px', '768px']);
+    expect(container.style.cssText).toBe(containerStyle);
+    expect(container.getBoundingClientRect()).toMatchObject({ width: 1366, height: 769 });
+  });
+
+  it('aligns physical pixels after HiDPI conversion, not CSS pixels', () => {
+    const { runtime, canvas, cursorEl } = fixture({ hiDpi: true, getDevicePixelRatio: () => 1.5 });
+    // 1366×1.5=2049 →2048, 769×1.5=1153.5 →1152.
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 2048, height: 1152 });
+    expect(parseFloat(canvas.style.width)).toBeCloseTo(2048 / 1.5);
+    expect(canvas.style.height).toBe('768px');
+    expect(cursorEl.style.cssText).toBe(canvas.style.cssText);
+  });
+
+  it('preserves scalar even alignment for hosts without CVT width constraints', () => {
+    const { runtime, setSize } = fixture({ resizeAlignment: 2 });
+    setSize(1367, 769);
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 1366, height: 768 });
+  });
+
+  it.each([undefined, 1])('preserves default/scalar1 CSS and odd dimensions (%s)', resizeAlignment => {
+    const { runtime, canvas, cursorEl } = fixture({ resizeAlignment });
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 1366, height: 769 });
+    expect(canvas.style.width).toBe('100%');
+    expect(cursorEl.style.height).toBe('100%');
+  });
+
+  it('leaves externally sized canvas-driven clients unchanged', () => {
+    const { runtime, canvas } = fixture({ resizeSource: 'canvas' });
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 1366, height: 769 });
+    expect(canvas.style.height).toBe('100%');
+  });
+
+  it.each([0, -2, 1.5, Infinity, NaN, 128])('ignores invalid or unreasonable physical alignment %s', resizeAlignment => {
+    const { runtime } = fixture({ resizeAlignment });
+    expect(runtime.initializeCanvasSize()).toEqual({ width: 1366, height: 769 });
+  });
+
+  it('debounces one normalized resize using available parent dimensions, not pinned child dimensions', async () => {
+    vi.useFakeTimers();
+    const { runtime, canvas, setSize, sendResizeRequest } = fixture();
+    runtime.initializeCanvasSize();
+    setSize(1441, 851);
+    runtime.handleResize(1441, 851);
+    setSize(1447, 853);
+    runtime.handleResize(1447, 853);
+    await vi.advanceTimersByTimeAsync(150);
+    expect(sendResizeRequest.mock.calls).toEqual([[1440, 852]]);
+    expect([canvas.style.width, canvas.style.height]).toEqual(['1440px', '852px']);
+    expect(runtime.getContainerResizeDims()).toEqual({ width: 1440, height: 852 });
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(sendResizeRequest).toHaveBeenCalledTimes(1);
+  });
+
+  it('never rounds authoritative locked dimensions and restores fit-to-small-container CSS', () => {
+    const { runtime, canvas, cursorEl, container, resizeObserver } = fixture();
+    runtime.initializeCanvasSize();
+    runtime.applyClientAccessState(0x02, 1921, 1081);
+    expect([canvas.width, canvas.height]).toEqual([1921, 1081]);
+    expect([canvas.style.width, canvas.style.height, cursorEl.style.width, cursorEl.style.height])
+      .toEqual(['100%', '100%', '100%', '100%']);
+    expect(container.style.width).toBe('');
+    expect(resizeObserver.disconnect).toHaveBeenCalledOnce();
+  });
+
+  it('keeps an authoritative small lock exact then resumes normalized owner sizing on unlock', () => {
+    const { runtime, canvas, cursorEl, container, sendResizeRequest } = fixture();
+    runtime.initializeCanvasSize();
+    runtime.applyClientAccessState(0x02, 1279, 767);
+    expect([canvas.width, canvas.height]).toEqual([1279, 767]);
+    expect([container.style.width, container.style.height]).toEqual(['1279px', '767px']);
+    runtime.applyClientAccessState(0, 0, 0);
+    expect([container.style.width, container.style.height]).toEqual(['', '']);
+    expect([canvas.width, canvas.height, cursorEl.width, cursorEl.height]).toEqual([1360, 768, 1360, 768]);
+    expect(sendResizeRequest.mock.calls).toEqual([[1360, 768]]);
+  });
+
+  it.each([1, 1.5, 2])('maps an edge input and local cursor to the same physical pixel at DPR%s', scale => {
+    const { runtime, canvas } = fixture({ hiDpi: true, getDevicePixelRatio: () => scale });
+    const size = runtime.initializeCanvasSize();
+    const sendMouseMove = vi.fn();
+    const drawCursor = vi.fn();
+    const abort = new AbortController();
+    new PointerInputRuntime({
+      canvas, drawCursor, getRemoteDims: () => size, sendMouseMove,
+      sendMouseButton: vi.fn(), sendScroll: vi.fn(), now: () => 100,
+    }).bind({ signal: abort.signal, focusKeyboardTarget: vi.fn() });
+    canvas.dispatchEvent(new MouseEvent('pointermove', {
+      clientX: 10 + (size.width - 1) / scale,
+      clientY: 51 + (size.height - 1) / scale,
+    }));
+    expect(sendMouseMove).toHaveBeenCalledWith(size.width - 1, size.height - 1);
+    expect(drawCursor).toHaveBeenCalledWith(null, size.width - 1, size.height - 1);
+    abort.abort();
+  });
+});
