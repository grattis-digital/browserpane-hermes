--- /dev/null
+++ b/code/web/bpane-client/js/__tests__/pointer-trailing-move.test.ts
@@ -0,0 +1,53 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { PointerInputRuntime } from '../input/pointer-input-runtime.js';
+
+function pointer(target: EventTarget, type: string, x: number): void {
+  const event = new Event(type, { bubbles: true, cancelable: true });
+  Object.defineProperties(event, { pointerId: { value: 1 }, button: { value: 0 },
+    clientX: { value: x }, clientY: { value: 50 } });
+  target.dispatchEvent(event);
+}
+
+function fixture() {
+  vi.useFakeTimers(); vi.setSystemTime(100);
+  const canvas = document.createElement('canvas'); document.body.append(canvas);
+  canvas.getBoundingClientRect = () => ({ left: 0, top: 0, width: 100, height: 100 } as DOMRect);
+  canvas.setPointerCapture = vi.fn(); canvas.releasePointerCapture = vi.fn();
+  const moves = vi.fn(), buttons = vi.fn(), abort = new AbortController();
+  const runtime = new PointerInputRuntime({ canvas, drawCursor: vi.fn(), getRemoteDims: () => ({ width: 100, height: 100 }),
+    sendMouseMove: moves, sendMouseButton: buttons, sendScroll: vi.fn(), now: () => Date.now() });
+  runtime.bind({ signal: abort.signal, focusKeyboardTarget: vi.fn() });
+  pointer(canvas, 'pointermove', 10); pointer(canvas, 'pointerdown', 10);
+  vi.advanceTimersByTime(5); pointer(canvas, 'pointermove', 20);
+  return { canvas, moves, buttons, abort, runtime };
+}
+
+afterEach(() => { vi.clearAllTimers(); vi.useRealTimers(); document.body.innerHTML = ''; });
+
+describe('bounded trailing pointer movement', () => {
+  it('delivers the latest held-drag endpoint without waiting for another input', () => {
+    const f = fixture();
+    vi.advanceTimersByTime(3); pointer(f.canvas, 'pointermove', 30);
+    expect(vi.getTimerCount()).toBe(1);
+    expect(f.moves.mock.calls).toEqual([[10, 50]]);
+    vi.advanceTimersByTime(8);
+    expect(f.moves.mock.calls).toEqual([[10, 50], [30, 50]]);
+    expect(vi.getTimerCount()).toBe(0);
+    f.abort.abort();
+  });
+
+  it.each(['up', 'abort', 'reset', 'blur', 'pointercancel', 'lostpointercapture'])(
+    'cannot send an old pending movement after %s', action => {
+      const f = fixture();
+      if (action === 'up') pointer(document.body, 'pointerup', 40);
+      else if (action === 'abort') f.abort.abort();
+      else if (action === 'reset') f.runtime.reset();
+      else if (action === 'blur') window.dispatchEvent(new Event('blur'));
+      else pointer(f.canvas, action, 20);
+      vi.advanceTimersByTime(50);
+      expect(f.moves.mock.calls).toEqual([[10, 50]]);
+      expect(f.buttons).toHaveBeenLastCalledWith(0, false, action === 'up' ? 40 : 20, 50);
+      expect(vi.getTimerCount()).toBe(0);
+      f.abort.abort();
+    });
+});
