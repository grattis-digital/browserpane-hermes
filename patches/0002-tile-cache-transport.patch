+}
+
+/// A bounded hash index and intrusive list in reusable, stable vector slots.
+/// All lookup, touch, insertion, eviction and removal operations are O(1)
+/// expected time; no unsafe code, per-touch allocation, or external dependency.
+pub(super) struct SentHashCache {
+    capacity: usize,
+    index: HashMap<u64, usize>,
+    entries: Vec<Entry>,
+    free: Vec<usize>,
+    oldest: usize,
+    newest: usize,
+}
+
+impl SentHashCache {
+    pub(super) fn new(capacity: usize) -> Self {
+        assert!(capacity > 0);
+        Self {
+            capacity,
+            index: HashMap::with_capacity(capacity),
+            entries: Vec::with_capacity(capacity),
+            free: Vec::with_capacity(capacity),
+            oldest: NONE,
+            newest: NONE,
+        }
+    }
+
+    pub(super) fn len(&self) -> usize {
+        self.index.len()
+    }
+
+    pub(super) fn contains(&self, hash: &u64) -> bool {
+        self.index.contains_key(hash)
+    }
+
+    pub(super) fn clear(&mut self) {
+        self.index.clear();
+        self.entries.clear();
+        self.free.clear();
+        self.oldest = NONE;
+        self.newest = NONE;
+    }
+
+    fn detach(&mut self, slot: usize) {
+        let entry = self.entries[slot];
+        if entry.previous == NONE {
+            self.oldest = entry.next;
+        } else {
+            self.entries[entry.previous].next = entry.next;
+        }
+        if entry.next == NONE {
+            self.newest = entry.previous;
+        } else {
+            self.entries[entry.next].previous = entry.previous;
+        }
+    }
+
+    fn append(&mut self, slot: usize) {
+        self.entries[slot].previous = self.newest;
+        self.entries[slot].next = NONE;
+        if self.newest == NONE {
+            self.oldest = slot;
+        } else {
+            self.entries[self.newest].next = slot;
+        }
+        self.newest = slot;
+    }
+
+    pub(super) fn touch(&mut self, hash: u64) -> bool {
+        let Some(&slot) = self.index.get(&hash) else {
+            return false;
+        };
+        if slot != self.newest {
+            self.detach(slot);
+            self.append(slot);
+        }
+        true
+    }
+
+    /// Return true only when this insertion evicted an older hash.
+    pub(super) fn insert(&mut self, hash: u64) -> bool {
+        if self.touch(hash) {
+            return false;
+        }
+        let evicted = self.len() == self.capacity;
+        if evicted {
+            self.remove(self.entries[self.oldest].hash);
+        }
+        let entry = Entry {
+            hash,
+            previous: NONE,
+            next: NONE,
+        };
+        let slot = if let Some(slot) = self.free.pop() {
+            self.entries[slot] = entry;
+            slot
+        } else {
+            self.entries.push(entry);
+            self.entries.len() - 1
+        };
+        self.index.insert(hash, slot);
+        self.append(slot);
+        evicted
+    }
+
+    /// Invalidate a hash without changing the recency of surviving entries.
+    pub(super) fn remove(&mut self, hash: u64) -> bool {
+        let Some(slot) = self.index.remove(&hash) else {
+            return false;
+        };
+        self.detach(slot);
+        self.free.push(slot);
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn order(cache: &SentHashCache) -> Vec<u64> {
+        let mut result = Vec::new();
+        let mut slot = cache.oldest;
+        let mut previous = NONE;
+        while slot != NONE {
+            assert!(
+                result.len() < cache.capacity,
+                "list must not contain a cycle"
+            );
+            let entry = cache.entries[slot];
+            assert_eq!(entry.previous, previous);
+            assert_eq!(cache.index.get(&entry.hash), Some(&slot));
+            result.push(entry.hash);
+            previous = slot;
+            slot = entry.next;
+        }
+        assert_eq!(previous, cache.newest);
+        assert_eq!(result.len(), cache.len());
+        assert_eq!(cache.entries.len(), cache.len() + cache.free.len());
+        assert!(cache.entries.len() <= cache.capacity);
+        result
+    }
+
+    #[test]
+    fn touch_and_insert_mirror_client_lru_order() {
+        let mut cache = SentHashCache::new(3);
+        for hash in [1, 2, 3] {
+            assert!(!cache.insert(hash));
+        }
+        assert!(cache.touch(1));
+        assert_eq!(order(&cache), [2, 3, 1]);
+        assert!(cache.insert(4));
+        assert!(!cache.contains(&2));
+        assert!(!cache.insert(3));
+        assert_eq!(order(&cache), [1, 4, 3]);
+        assert!(!cache.touch(99));
+    }
+
+    #[test]
+    fn invalidation_preserves_order_and_reuses_storage() {
+        let mut cache = SentHashCache::new(4);
+        for hash in [1, 2, 3, 4] {
+            cache.insert(hash);
+        }
+        assert!(cache.remove(2));
+        assert_eq!(order(&cache), [1, 3, 4]);
+        assert!(!cache.remove(2));
+        assert!(!cache.insert(5));
+        assert_eq!(order(&cache), [1, 3, 4, 5]);
+        assert!(cache.insert(6));
+        assert_eq!(order(&cache), [3, 4, 5, 6]);
+        assert_eq!(cache.entries.len(), 4);
+    }
+
+    #[test]
+    fn single_entry_and_clear_are_reusable() {
+        let mut cache = SentHashCache::new(1);
+        cache.insert(1);
+        assert!(cache.touch(1));
+        assert!(cache.insert(2));
+        assert_eq!(order(&cache), [2]);
+        assert!(cache.remove(2));
+        assert!(order(&cache).is_empty());
+        cache.insert(3);
+        cache.clear();
+        assert!(order(&cache).is_empty());
+        assert!(!cache.insert(4));
+        assert_eq!(order(&cache), [4]);
+    }
+
+    #[test]
+    fn randomized_operations_match_reference_client_order() {
+        let mut cache = SentHashCache::new(31);
+        let mut reference = Vec::new();
+        let mut seed = 0x1234_5678_u64;
+        for _ in 0..30_000 {
+            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+            let hash = (seed >> 32) % 83;
+            let position = reference.iter().position(|&entry| entry == hash);
+            match seed % 13 {
+                0 => {
+                    cache.clear();
+                    reference.clear();
+                }
+                1..=3 => {
+                    assert_eq!(cache.remove(hash), position.is_some());
+                    if let Some(position) = position {
+                        reference.remove(position);
+                    }
+                }
+                4..=7 => {
+                    assert_eq!(cache.touch(hash), position.is_some());
+                    if let Some(position) = position {
+                        reference.remove(position);
+                        reference.push(hash);
+                    }
+                }
+                _ => {
+                    let evicted = position.is_none() && reference.len() == 31;
+                    if let Some(position) = position {
+                        reference.remove(position);
+                    }
+                    if evicted {
+                        reference.remove(0);
+                    }
+                    reference.push(hash);
+                    assert_eq!(cache.insert(hash), evicted);
+                }
+            }
+            assert_eq!(order(&cache), reference);
+        }
+    }
+
+    /// Run explicitly with --release --ignored --nocapture. Measures cache
+    /// bookkeeping only, not capture, codecs, transport or end-to-end latency.
+    #[test]
+    #[ignore]
+    fn benchmark_warm_cache_against_original_indexset() {
+        use indexmap::IndexSet;
+        use std::hint::black_box;
+        use std::time::Instant;
+
+        const CAPACITY: usize = 8192;
+        const OPERATIONS: usize = 100_000;
+        for workload in ["scroll_reuse", "new_content"] {
+            for round in 0..3 {
+                let mut original = IndexSet::with_capacity(CAPACITY);
+                let mut improved = SentHashCache::new(CAPACITY);
+                for hash in 1..=CAPACITY as u64 {
+                    original.insert(hash);
+                    improved.insert(hash);
+                }
+                let started = Instant::now();
+                for step in 0..OPERATIONS {
+                    let hash = if workload == "scroll_reuse" {
+                        (step % CAPACITY + 1) as u64
+                    } else {
+                        (CAPACITY + step + 1) as u64
+                    };
+                    if let Some(index) = original.get_index_of(&hash) {
+                        original.move_index(index, original.len() - 1);
+                    } else {
+                        original.shift_remove_index(0);
+                        original.insert(hash);
+                    }
+                    black_box(&original);
+                }
+                let original_us = started.elapsed().as_micros();
+                let started = Instant::now();
+                for step in 0..OPERATIONS {
+                    let hash = if workload == "scroll_reuse" {
+                        (step % CAPACITY + 1) as u64
+                    } else {
+                        (CAPACITY + step + 1) as u64
+                    };
+                    improved.insert(hash);
+                    black_box(&improved);
+                }
+                let improved_us = started.elapsed().as_micros();
+                assert_eq!(
+                    order(&improved),
+                    original.iter().copied().collect::<Vec<_>>()
+                );
+                println!("{{\"workload\":\"{workload}\",\"round\":{round},\"capacity\":{CAPACITY},\"operations\":{OPERATIONS},\"original_us\":{original_us},\"improved_us\":{improved_us}}}");
+            }
+        }
+    }
+}
