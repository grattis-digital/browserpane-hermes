+
+impl TileZstdEncoder {
+    fn encode(&mut self, rgba: &[u8]) -> Option<Vec<u8>> {
+        // Matches the largest tile permitted by tile_size_from_env(). No
+        // dictionaries, workers or cross-tile compression history are used.
+        if rgba.len() > 256 * 256 * 4 {
+            return None;
+        }
+        if self.compressor.is_none() {
+            self.compressor = Some(zstd::bulk::Compressor::new(1).ok()?);
+        }
+        self.output.clear();
+        let bound = zstd::zstd_safe::compress_bound(rgba.len());
+        if self.output.capacity() < bound {
+            self.output.reserve_exact(bound);
+        }
+        self.compressor
+            .as_mut()?
+            .compress_to_buffer(rgba, &mut self.output)
+            .ok()?;
+        // Wire frames own their bytes until asynchronous delivery completes.
+        // Copy only the compressed result, retaining the bounded work buffer.
+        Some(self.output.clone())
+    }
