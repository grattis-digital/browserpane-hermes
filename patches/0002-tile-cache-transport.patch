+/// Independent zstd frames at the existing level 1, without allocating a native
+/// streaming context or copying through Read buffers for every small tile.
+#[derive(Default)]
+struct TileZstdEncoder {
+    compressor: Option<zstd::bulk::Compressor<'static>>,
+    output: Vec<u8>,
