@@ -0,0 +1,60 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { PointerInputRuntime } from '../input/pointer-input-runtime.js';
+
+function pointer(target: EventTarget, type: string, x = 30, y = 40, id = 1): void {
+  const event = new Event(type, { bubbles: true, cancelable: true });
+  Object.defineProperties(event, { clientX: { value: x }, clientY: { value: y },
+    pointerId: { value: id }, button: { value: 0 } });
+  target.dispatchEvent(event);
+}
+
+function fixture() {
+  const canvas = document.createElement('canvas'); document.body.append(canvas);
+  canvas.getBoundingClientRect = () => ({ left: 10, top: 20, width: 100, height: 100 } as DOMRect);
+  canvas.setPointerCapture = vi.fn(); canvas.releasePointerCapture = vi.fn();
+  const buttons = vi.fn(), moves = vi.fn(), abort = new AbortController();
+  const runtime = new PointerInputRuntime({ canvas, drawCursor: vi.fn(),
+    getRemoteDims: () => ({ width: 1000, height: 1000 }),
+    sendMouseMove: moves, sendMouseButton: buttons, sendScroll: vi.fn(), now: () => 100 });
+  runtime.bind({ signal: abort.signal, focusKeyboardTarget: vi.fn() });
+  return { canvas, buttons, moves, abort, runtime };
+}
+
+afterEach(() => { document.body.innerHTML = ''; });
+
+describe('scrollbar drag lifetime', () => {
+  it('captures the pointer and releases an owned drag outside the canvas at clamped coordinates', () => {
+    const f = fixture();
+    pointer(f.canvas, 'pointerdown');
+    expect(f.canvas.setPointerCapture).toHaveBeenCalledWith(1);
+    pointer(document.body, 'pointermove', 400, 500);
+    pointer(document.body, 'pointerup', 400, 500);
+    expect(f.moves).toHaveBeenLastCalledWith(999, 999);
+    expect(f.buttons.mock.calls).toEqual([[0, true, 200, 200], [0, false, 999, 999]]);
+    pointer(f.canvas, 'lostpointercapture');
+    expect(f.buttons).toHaveBeenCalledTimes(2);
+    f.abort.abort();
+  });
+
+  it.each(['pointercancel', 'lostpointercapture', 'blur', 'abort', 'reset'])(
+    'releases exactly once on %s and never releases unrelated input', action => {
+      const f = fixture(); pointer(document.body, 'pointerup'); expect(f.buttons).not.toHaveBeenCalled();
+      pointer(f.canvas, 'pointerdown');
+      pointer(document.body, 'pointerup', 20, 20, 2); expect(f.buttons).toHaveBeenCalledTimes(1);
+      if (action === 'blur') window.dispatchEvent(new Event('blur'));
+      else if (action === 'abort') f.abort.abort();
+      else if (action === 'reset') f.runtime.reset();
+      else pointer(f.canvas, action);
+      expect(f.buttons.mock.calls).toEqual([[0, true, 200, 200], [0, false, 200, 200]]);
+      pointer(f.canvas, 'pointerup'); f.runtime.reset(); f.abort.abort();
+      expect(f.buttons.mock.calls).toEqual([[0, true, 200, 200], [0, false, 200, 200]]);
+    });
+
+  it('keeps document release fallback if native capture is unavailable', () => {
+    const f = fixture();
+    f.canvas.setPointerCapture = () => { throw new DOMException('No active pointer'); };
+    pointer(f.canvas, 'pointerdown'); pointer(document.body, 'pointerup', -100, -100);
+    expect(f.buttons.mock.calls).toEqual([[0, true, 200, 200], [0, false, 0, 0]]);
+    f.abort.abort();
+  });
+});
