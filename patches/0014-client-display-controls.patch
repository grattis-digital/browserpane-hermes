@@ -0,0 +1,294 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { SessionResizeRuntime } from '../session-resize-runtime.js';
+import { SessionConnectOptionsValidator } from '../shared/connect-options-validator.js';
+import { validateCaptureScale, validateCaptureSize } from '../shared/display-options-validator.js';
+import { PointerInputRuntime } from '../input/pointer-input-runtime.js';
+
+function fixture(overrides: Partial<ConstructorParameters<typeof SessionResizeRuntime>[0]> = {}) {
+  const container = document.createElement('div');
+  container.style.cssText = 'width:800px;height:600px;flex:none;max-width:100%;resize:both';
+  const canvas = document.createElement('canvas');
+  const cursorEl = document.createElement('canvas');
+  let cssWidth = 800, cssHeight = 600;
+  const rect = () => ({ x: 41, y: 73, left: 41, top: 73, width: cssWidth, height: cssHeight,
+    right: 41 + cssWidth, bottom: 73 + cssHeight, toJSON() {} });
+  container.getBoundingClientRect = rect;
+  canvas.getBoundingClientRect = rect;
+  for (const child of [canvas, cursorEl]) {
+    child.style.width = '100%'; child.style.height = '100%';
+    container.appendChild(child);
+  }
+  const sendResizeRequest = vi.fn(), resizeRenderer = vi.fn(), onDisplayStateChange = vi.fn();
+  const runtime = new SessionResizeRuntime({ container, canvas, cursorEl,
+    hiDpi: false, resizeSource: 'container', resizeAlignment: { width: 8, height: 2 },
+    resizeObserver: { observe: vi.fn(), disconnect: vi.fn() },
+    sendResizeRequest, resizeRenderer, onDisplayStateChange, markDisplayDirty: vi.fn(),
+    setRemoteSize: vi.fn(), getDevicePixelRatio: () => 2, ...overrides });
+  return { runtime, container, canvas, cursorEl, sendResizeRequest, resizeRenderer, onDisplayStateChange,
+    setCssSize(width: number, height: number) { cssWidth = width; cssHeight = height; } };
+}
+
+afterEach(() => vi.useRealTimers());
+
+describe('explicit capture options validation', () => {
+  it.each([undefined, 1, 1.25, 1.5, 2, 3])('accepts capture scale %s', value => {
+    expect(() => validateCaptureScale(value)).not.toThrow();
+  });
+  it.each([null, '2', NaN, Infinity, -Infinity, 0, 0.99, 3.01])('rejects capture scale %s before creating a session', value => {
+    expect(() => SessionConnectOptionsValidator.validate({ container: document.createElement('div'),
+      gatewayUrl: 'https://localhost', token: 'test', captureScale: value })).toThrow(/captureScale/);
+    expect(() => fixture({ captureScale: value as number })).toThrow(/captureScale/);
+    const { runtime } = fixture({ captureScale: 1.5 });
+    expect(() => runtime.setCaptureScale(value as number)).toThrow(/captureScale/);
+    expect(runtime.getCaptureScale()).toBe(1.5);
+  });
+  it.each([undefined, { width: 1, height: 1 }, { width: 65535, height: 65535 }, { width: 1366, height: 769 }])
+  ('accepts exact positive protocol dimensions %j without host-specific rounding', value => {
+    expect(() => validateCaptureSize(value)).not.toThrow();
+    if (value) expect(fixture({ captureSize: value }).runtime.initializeCanvasSize()).toEqual(value);
+  });
+  it.each([null, '800x600', {}, { width: 0, height: 600 }, { width: 800, height: 65536 },
+    { width: 800.5, height: 600 }, { width: 800, height: NaN }, { width: '800', height: 600 }])
+  ('rejects invalid physical dimensions %j without altering the current setting', value => {
+    expect(() => SessionConnectOptionsValidator.validate({ container: document.createElement('div'),
+      gatewayUrl: 'https://localhost', token: 'test', captureSize: value })).toThrow(/captureSize/);
+    const { runtime } = fixture({ captureSize: { width: 1280, height: 720 } });
+    expect(() => runtime.setCaptureSize(value as any)).toThrow(/captureSize/);
+    expect(runtime.getContainerResizeDims()).toEqual({ width: 1280, height: 720 });
+  });
+});
+
+describe('live density and physical resolution', () => {
+  it('initializes renderer state even if requested dimensions match the default canvas backing', () => {
+    const { runtime, canvas, resizeRenderer } = fixture({ captureSize: { width: 300, height: 150 } });
+    const widthSetter = vi.spyOn(canvas, 'width', 'set');
+    runtime.initializeCanvasSize();
+    runtime.initializeCanvasSize();
+    expect(resizeRenderer.mock.calls).toEqual([[300, 150]]);
+    expect(widthSetter).not.toHaveBeenCalled();
+  });
+
+  it.each([1, 1.5, 3])('keeps the same preset physical pixels at scale %s and at a tiny fitted CSS size', async captureScale => {
+    vi.useFakeTimers();
+    const f = fixture({ captureScale, captureSize: { width: 1920, height: 1080 } });
+    expect(f.runtime.initializeCanvasSize()).toEqual({ width: 1920, height: 1080 });
+    const widthSetter = vi.spyOn(f.canvas, 'width', 'set');
+    f.resizeRenderer.mockClear();
+    f.setCssSize(240, 135);
+    f.runtime.handleResize(240, 135);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(f.runtime.getContainerResizeDims({ width: 240, height: 135 })).toEqual({ width: 1920, height: 1080 });
+    expect([f.canvas.width, f.canvas.height, f.cursorEl.width, f.cursorEl.height]).toEqual([1920, 1080, 1920, 1080]);
+    expect([f.canvas.style.width, f.canvas.style.height, f.cursorEl.style.width, f.cursorEl.style.height])
+      .toEqual(['100%', '100%', '100%', '100%']);
+    expect(f.sendResizeRequest).not.toHaveBeenCalled();
+    expect(f.resizeRenderer).not.toHaveBeenCalled();
+    expect(widthSetter).not.toHaveBeenCalled();
+    f.runtime.destroy();
+  });
+
+  it('coalesces same-frame scale and size changes into one exact physical request', async () => {
+    vi.useFakeTimers();
+    const f = fixture();
+    f.runtime.initializeCanvasSize();
+    f.runtime.setCaptureScale(1.5);
+    const size = { width: 1920, height: 1080 };
+    f.runtime.setCaptureSize(size);
+    size.width = 800; // Public options are copied, not retained mutable caller objects.
+    f.runtime.setCaptureScale(2);
+    f.runtime.handleResize(320, 180);
+    await vi.advanceTimersByTimeAsync(150);
+    expect(f.sendResizeRequest.mock.calls).toEqual([[1920, 1080]]);
+    expect(f.runtime.getCaptureScale()).toBe(2);
+    expect(f.canvas.width).toBe(1920);
+    f.runtime.setCaptureSize({ width: 1920, height: 1080 });
+    f.runtime.setCaptureScale(3);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(f.sendResizeRequest).toHaveBeenCalledTimes(1);
+    expect(f.onDisplayStateChange).toHaveBeenCalled();
+    f.runtime.destroy();
+  });
+
+  it('resumes aligned CSS-times-scale capture after clearing an explicit preset', async () => {
+    vi.useFakeTimers();
+    const size = { width: 1920, height: 1080 };
+    const f = fixture({ captureSize: size, captureScale: 1.5 });
+    size.height = 600;
+    f.runtime.initializeCanvasSize();
+    expect(f.canvas.height).toBe(1080);
+    f.setCssSize(1366, 769);
+    f.runtime.setCaptureSize(undefined);
+    await vi.advanceTimersByTimeAsync(150);
+    expect(f.sendResizeRequest.mock.calls).toEqual([[2048, 1152]]);
+    expect(parseFloat(f.canvas.style.width)).toBeCloseTo(2048 / 1.5);
+    expect(f.canvas.style.height).toBe('768px');
+    f.runtime.destroy();
+  });
+
+  it('changes live scale without reconnecting and undefined restores legacy hiDpi', async () => {
+    vi.useFakeTimers();
+    const f = fixture({ hiDpi: true, captureScale: 1.5 });
+    f.runtime.initializeCanvasSize();
+    expect(f.canvas.width).toBe(1200);
+    f.runtime.setCaptureScale(1);
+    await vi.advanceTimersByTimeAsync(150);
+    f.runtime.setCaptureScale(undefined);
+    await vi.advanceTimersByTimeAsync(150);
+    expect(f.sendResizeRequest.mock.calls).toEqual([[800, 600], [1600, 1200]]);
+    f.runtime.destroy();
+  });
+
+  it.each([1, 1.5, 3])('maps centered fitted input and cursor to exact physical pixels at density %s', captureScale => {
+    const f = fixture({ captureSize: { width: 1920, height: 1080 }, captureScale });
+    const size = f.runtime.initializeCanvasSize();
+    f.setCssSize(320, 180);
+    const drawCursor = vi.fn(), sendMouseMove = vi.fn(), abort = new AbortController();
+    new PointerInputRuntime({ canvas: f.canvas, drawCursor, getRemoteDims: () => size, sendMouseMove,
+      sendMouseButton: vi.fn(), sendScroll: vi.fn(), now: () => 100 })
+      .bind({ signal: abort.signal, focusKeyboardTarget: vi.fn() });
+    f.canvas.dispatchEvent(new MouseEvent('pointermove', { clientX: 41 + 319, clientY: 73 + 179 }));
+    expect(sendMouseMove).toHaveBeenLastCalledWith(1914, 1074);
+    expect(drawCursor).toHaveBeenLastCalledWith(null, 1914, 1074);
+    abort.abort();
+    f.runtime.destroy();
+  });
+});
+
+describe('shared-session lock and layout ownership', () => {
+  it('preserves locked physical size and caller CSS while storing new owner preferences', async () => {
+    vi.useFakeTimers();
+    const f = fixture({ captureSize: { width: 1280, height: 720 } });
+    const style = f.container.style.cssText;
+    f.runtime.initializeCanvasSize();
+    f.runtime.applyClientAccessState(0x02, 1279, 767);
+    f.resizeRenderer.mockClear();
+    const widthSetter = vi.spyOn(f.canvas, 'width', 'set');
+    f.runtime.setCaptureScale(2);
+    f.runtime.setCaptureSize({ width: 1920, height: 1080 });
+    // The wrapper may recompute its preferred capture while this viewer is
+    // locked. Promotion must use the latest preference, not the visible lock.
+    f.runtime.setCaptureSize({ width: 2560, height: 1440 });
+    f.runtime.handleResize(240, 135);
+    await vi.advanceTimersByTimeAsync(500);
+    expect([f.canvas.width, f.canvas.height]).toEqual([1279, 767]);
+    expect(f.runtime.isResolutionLocked()).toBe(true);
+    expect(f.container.style.cssText).toBe(style);
+    expect(f.sendResizeRequest).not.toHaveBeenCalled();
+    expect(f.resizeRenderer).not.toHaveBeenCalled();
+    expect(widthSetter).not.toHaveBeenCalled();
+    f.runtime.applyClientAccessState(0, 0, 0);
+    expect(f.sendResizeRequest.mock.calls).toEqual([[2560, 1440]]);
+    expect(f.container.style.cssText).toBe(style);
+    f.runtime.destroy();
+    expect(f.container.style.cssText).toBe(style);
+  });
+
+  it('restores pre-existing caller inline sizing after a legacy lock instead of clearing it', () => {
+    const f = fixture();
+    const sizing = () => ['width', 'height', 'flex', 'max-width', 'max-height', 'resize']
+      .map(key => f.container.style.getPropertyValue(key));
+    const style = sizing();
+    f.runtime.initializeCanvasSize();
+    f.runtime.applyClientAccessState(0x02, 640, 400);
+    expect(f.container.style.width).toBe('640px');
+    f.runtime.applyClientAccessState(0, 0, 0);
+    expect(sizing()).toEqual(style);
+    f.runtime.applyClientAccessState(0x02, 640, 400);
+    f.runtime.destroy();
+    expect(sizing()).toEqual(style);
+  });
+
+  it('cancels an already queued owner resize when a dimensionless lock arrives', async () => {
+    vi.useFakeTimers();
+    const f = fixture();
+    f.runtime.initializeCanvasSize();
+    f.runtime.setCaptureScale(2);
+    f.runtime.applyClientAccessState(0x02, 0, 0);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(f.canvas.width).toBe(800);
+    expect(f.sendResizeRequest).not.toHaveBeenCalled();
+    expect(f.onDisplayStateChange).toHaveBeenCalled();
+    f.runtime.destroy();
+  });
+
+  it('does not overwrite a newly fitted caller layout when leaving legacy lock sizing', () => {
+    const f = fixture();
+    f.runtime.initializeCanvasSize();
+    f.runtime.applyClientAccessState(0x02, 640, 400);
+    f.container.style.width = '480px';
+    f.container.style.height = '300px';
+    f.container.style.maxWidth = '100%';
+    f.runtime.setCaptureSize({ width: 1280, height: 720 });
+    expect([f.container.style.width, f.container.style.height, f.container.style.maxWidth])
+      .toEqual(['480px', '300px', '100%']);
+    f.runtime.destroy();
+    expect([f.container.style.width, f.container.style.height]).toEqual(['480px', '300px']);
+  });
+});
+
+describe('Auto density monitor changes', () => {
+  function mediaFixture(fixed = false) {
+    let dpr = 1;
+    const queries: { query: string; addEventListener: ReturnType<typeof vi.fn>; removeEventListener: ReturnType<typeof vi.fn> }[] = [];
+    const matchMedia = vi.fn((query: string) => {
+      const result = { query, addEventListener: vi.fn(), removeEventListener: vi.fn() };
+      queries.push(result); return result;
+    });
+    const f = fixture({ hiDpi: true, getDevicePixelRatio: () => dpr, matchMedia,
+      captureSize: fixed ? { width: 1280, height: 720 } : undefined });
+    f.runtime.initializeCanvasSize();
+    return { ...f, queries, changeDpr(value: number) {
+      dpr = value;
+      queries.at(-1)!.addEventListener.mock.calls[0][1]();
+    } };
+  }
+
+  it('re-arms the DPR query, detaches on manual override, restores Auto, and cleans up on destroy', async () => {
+    vi.useFakeTimers();
+    const f = mediaFixture();
+    expect(f.queries[0].query).toBe('(resolution: 1dppx)');
+    f.changeDpr(1.5);
+    expect(f.queries[0].removeEventListener).toHaveBeenCalledWith('change', f.queries[0].addEventListener.mock.calls[0][1]);
+    expect(f.queries[1].query).toBe('(resolution: 1.5dppx)');
+    await vi.advanceTimersByTimeAsync(150);
+    expect(f.sendResizeRequest.mock.calls).toEqual([[1200, 900]]);
+    f.runtime.setCaptureScale(1);
+    expect(f.queries[1].removeEventListener).toHaveBeenCalledOnce();
+    f.runtime.setCaptureScale(undefined);
+    expect(f.queries[2].query).toBe('(resolution: 1.5dppx)');
+    f.changeDpr(2);
+    const staleCallback = f.queries[3].addEventListener.mock.calls[0][1];
+    f.runtime.destroy();
+    expect(f.queries[3].removeEventListener).toHaveBeenCalledWith('change', staleCallback);
+    staleCallback();
+    await vi.advanceTimersByTimeAsync(500);
+    expect(f.sendResizeRequest).toHaveBeenCalledTimes(1);
+  });
+
+  it('updates Auto density for a fixed preset without physical resize or bitmap clearing', async () => {
+    vi.useFakeTimers();
+    const f = mediaFixture(true);
+    f.resizeRenderer.mockClear();
+    f.changeDpr(2);
+    await vi.advanceTimersByTimeAsync(500);
+    expect(f.runtime.getCaptureScale()).toBe(2);
+    expect(f.onDisplayStateChange).toHaveBeenCalled();
+    expect(f.sendResizeRequest).not.toHaveBeenCalled();
+    expect(f.resizeRenderer).not.toHaveBeenCalled();
+    expect([f.canvas.width, f.canvas.height]).toEqual([1280, 720]);
+    f.runtime.destroy();
+  });
+
+  it('never resizes the remote capture or clears the framebuffer on monitor changes while locked', async () => {
+    vi.useFakeTimers();
+    const f = mediaFixture();
+    f.runtime.applyClientAccessState(0x02, 1921, 1081);
+    f.resizeRenderer.mockClear();
+    f.changeDpr(2);
+    await vi.advanceTimersByTimeAsync(500);
+    expect([f.canvas.width, f.canvas.height]).toEqual([1921, 1081]);
+    expect(f.sendResizeRequest).not.toHaveBeenCalled();
+    expect(f.resizeRenderer).not.toHaveBeenCalled();
+    f.runtime.destroy();
+  });
+});
