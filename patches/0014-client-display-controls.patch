@@ -0,0 +1,18 @@
+import type { SessionCaptureSize } from '../bpane-types.js';
+import { ValidationError } from './errors.js';
+
+export function validateCaptureScale(value: unknown): asserts value is number | undefined {
+  if (value !== undefined && (typeof value !== 'number' || !Number.isFinite(value) || value < 1 || value > 3)) {
+    throw new ValidationError('bpane.display.invalid_capture_scale', 'captureScale must be a finite number from 1 through 3');
+  }
+}
+
+export function validateCaptureSize(value: unknown): asserts value is SessionCaptureSize | undefined {
+  if (value === undefined) return;
+  const size = value as Partial<SessionCaptureSize> | null;
+  if (typeof size !== 'object' || size === null
+    || typeof size.width !== 'number' || !Number.isInteger(size.width) || size.width < 1 || size.width > 65535
+    || typeof size.height !== 'number' || !Number.isInteger(size.height) || size.height < 1 || size.height > 65535) {
+    throw new ValidationError('bpane.display.invalid_capture_size', 'captureSize requires positive uint16 integer width and height');
+  }
+}
