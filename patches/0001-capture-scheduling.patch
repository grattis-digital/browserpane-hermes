 use crate::tiles;
 
+#[test]
+fn capture_budget_wait_never_adds_delay_after_overrun() {
+    use std::time::Duration;
+    let interval = Duration::from_millis(16);
+    assert_eq!(super::run::capture_budget_wait(interval, Duration::ZERO), interval);
+    assert_eq!(super::run::capture_budget_wait(interval, Duration::from_millis(12)), Duration::from_millis(4));
+    assert_eq!(super::run::capture_budget_wait(interval, interval), Duration::ZERO);
+    assert_eq!(super::run::capture_budget_wait(interval, Duration::from_millis(120)), Duration::ZERO);
+}
