+    /// Sleep until X11 has activity, without burning CPU on a polling loop.
+    /// The finite timeout also lets the caller service cache misses/disconnects.
+    pub fn wait_for_damage(&mut self, timeout: std::time::Duration) {
+        use std::os::fd::AsRawFd;
+        self.drain_events();
+        if self.dirty {
+            return;
+        }
+        let mut descriptor = libc::pollfd {
+            fd: self.conn.stream().as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        let timeout_ms = timeout.as_millis().min(i32::MAX as u128) as i32;
+        let result = unsafe { libc::poll(&mut descriptor, 1, timeout_ms) };
+        if result < 0 || descriptor.revents & (libc::POLLERR | libc::POLLHUP | libc::POLLNVAL) != 0
+        {
+            self.force_refresh();
+            // A broken X socket must not turn the capture thread into a spin.
+            std::thread::sleep(timeout);
+        }
+    }
