+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::capture::ffmpeg::PipelineCmd;
+    use crate::video_region::RegionCommitter;
+    use std::sync::atomic::AtomicBool;
+    use std::time::Instant;
+
+    #[test]
+    fn video_exit_stops_encoder_before_restoring_full_screen_region() {
+        let now = Instant::now();
+        let mut last_toggle = now;
+        let mut region = RegionCommitter::new();
+        region.apply_reconfig(
+            Some(CaptureRegion {
+                x: 0,
+                y: 64,
+                w: 640,
+                h: 360,
+            }),
+            now,
+        );
+        let mut enabled = true;
+        let tiles_active = AtomicBool::new(false);
+        let (tx, rx) = std::sync::mpsc::channel();
+        end_h264_region(
+            &mut region,
+            &mut enabled,
+            &mut last_toggle,
+            &tiles_active,
+            &tx,
+            now,
+        );
+        assert!(tiles_active.load(Ordering::Acquire));
+        assert!(!enabled);
+        assert_eq!(region.active, None);
+        assert!(matches!(rx.try_recv(), Ok(PipelineCmd::SetEnabled(false))));
+        assert!(matches!(rx.try_recv(), Ok(PipelineCmd::SetRegion(None))));
+        assert!(rx.try_recv().is_err());
+
+        // No extra damage/capture is needed to expire a minimum-on timer, and
+        // subsequent idle iterations cannot restart the full-screen encoder.
+        end_h264_region(
+            &mut region,
+            &mut enabled,
+            &mut last_toggle,
+            &tiles_active,
+            &tx,
+            now,
+        );
+        assert!(rx.try_recv().is_err());
     }
 }
