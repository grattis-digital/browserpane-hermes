+#[test]
+fn idle_video_exit_wakes_until_the_reliable_region_clear_is_emitted() {
+    let hint = PageHintState::default();
+    let emitted = Some(tiles::Rect::new(0, 64, 640, 360));
+    // The encoder region can already be cleared while a previous batch still
+    // owns client pixels. That pending clear must bypass XDamage gating.
+    assert!(super::run::should_force_refresh_for_video_hint_drop(
+        None, emitted, &hint
+    ));
+    // Once the exit batch is emitted, a static page can sleep again.
+    assert!(!super::run::should_force_refresh_for_video_hint_drop(
+        None, None, &hint
