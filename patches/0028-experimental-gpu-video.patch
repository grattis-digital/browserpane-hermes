@@ -0,0 +1,192 @@
+//! Bounded worker output state; reliable tiles authorize each video access unit.
+use anyhow::{bail, ensure};
+use bpane_protocol::{TileMessage, VideoTileInfo};
+
+#[derive(Default)]
+pub struct GpuOutput {
+    pending: Option<u32>,
+    count: usize,
+    bytes: usize,
+    screen: Option<(u16, u16)>,
+    region: Option<(u16, u16, u16, u16)>,
+    video_allowed: bool,
+}
+impl GpuOutput {
+    pub fn tile(&mut self, message: TileMessage, length: usize) -> anyhow::Result<()> {
+        match message {
+            TileMessage::GpuBegin { frame_seq, .. } => {
+                ensure!(self.pending.is_none(), "overlapping GPU batches");
+                self.pending = Some(frame_seq);
+                self.video_allowed = false;
+                self.count = 0;
+                self.bytes = 0;
+            }
+            TileMessage::BatchEnd { frame_seq } => {
+                ensure!(
+                    self.pending == Some(frame_seq),
+                    "GPU batch sequence mismatch"
+                );
+                self.pending = None;
+                self.video_allowed = self.region.is_some();
+            }
+            TileMessage::GridConfig {
+                tile_size,
+                cols,
+                rows,
+                screen_w,
+                screen_h,
+            } => {
+                ensure!(
+                    self.pending.is_some()
+                        && tile_size == 64
+                        && (32..=1920).contains(&screen_w)
+                        && (32..=1080).contains(&screen_h)
+                        && cols == screen_w.div_ceil(64)
+                        && rows == screen_h.div_ceil(64),
+                    "GPU grid outside batch/bounds"
+                );
+                self.screen = Some((screen_w, screen_h));
+                self.region = None;
+            }
+            TileMessage::VideoRegion { x, y, w, h } => {
+                ensure!(self.pending.is_some(), "GPU video region outside batch");
+                let (sw, sh) = self
+                    .screen
+                    .ok_or_else(|| anyhow::anyhow!("GPU video before grid"))?;
+                ensure!(
+                    (x == 0 && y == 0 && w == 0 && h == 0)
+                        || (w >= 64
+                            && h >= 64
+                            && (x | y | w | h) % 2 == 0
+                            && x as u32 + w as u32 <= sw as u32
+                            && y as u32 + h as u32 <= sh as u32),
+                    "GPU video bounds"
+                );
+                self.region = (w != 0).then_some((x, y, w, h));
+            }
+            TileMessage::Qoi { .. }
+            | TileMessage::Fill { .. }
+            | TileMessage::CacheHit { .. }
+            | TileMessage::ScrollCopy { .. } => {
+                ensure!(self.pending.is_some(), "GPU command outside batch");
+            }
+            _ => bail!("unexpected GPU output command"),
+        }
+        self.count += 1;
+        self.bytes += length;
+        ensure!(
+            self.count <= 520 && self.bytes <= 9 * 1024 * 1024,
+            "GPU batch bounds exceeded"
+        );
+        Ok(())
+    }
+    pub fn video_header(&self, length: usize) -> anyhow::Result<()> {
+        ensure!(
+            self.pending.is_none() && self.video_allowed && (29..=1_048_600).contains(&length),
+            "GPU video framing"
+        );
+        Ok(())
+    }
+    pub fn video(&mut self, t: VideoTileInfo) -> anyhow::Result<()> {
+        ensure!(
+            self.video_allowed
+                && self.pending.is_none()
+                && self.screen == Some((t.screen_w, t.screen_h))
+                && self.region == Some((t.tile_x, t.tile_y, t.tile_w, t.tile_h)),
+            "GPU video ownership"
+        );
+        self.video_allowed = false;
+        Ok(())
+    }
+}
+
