+#[test]
+fn hint_requires_fresh_stable_video_and_expires_without_damage() {
+    let now = Instant::now();
+    let mut tracker = HintTracker::new(now);
+    let first = tracker.command(hint(1), now, 1280, 720);
+    assert_eq!(&first[2..10], &[0; 8]);
+    let same = tracker.command(hint(1), now + Duration::from_millis(100), 1280, 720);
+    assert_eq!(&same[2..10], &[0; 8]);
+    let ready = tracker.command(hint(2), now + Duration::from_millis(200), 1280, 720);
+    assert_eq!(
+        ready,
+        [16, 1, 14, 0, 22, 0, 130, 2, 106, 1, 0, 5, 208, 2, 0, 0]
+    );
+    let stale = tracker.command(hint(2), now + Duration::from_millis(701), 1280, 720);
+    assert_eq!(&stale[2..10], &[0; 8]);
+}
+#[test]
+fn no_editable_or_ambiguous_target_and_move_revokes_immediately() {
+    let now = Instant::now();
+    let mut t = HintTracker::new(now);
+    t.command(hint(1), now, 1280, 720);
+    t.command(hint(2), now, 1280, 720);
+    let mut moved = hint(3);
+    moved.video_region.as_mut().unwrap().y += 2;
+    assert_eq!(&t.command(moved, now, 1280, 720)[2..10], &[0; 8]);
+    let mut editable = hint(4);
+    editable.region_kind = HintRegionKind::Editable;
+    assert_eq!(&t.command(editable, now, 1280, 720)[2..10], &[0; 8]);
+    let mut ambiguous = hint(5);
+    ambiguous.focus_ambiguous = true;
+    assert_eq!(&t.command(ambiguous, now, 1280, 720)[2..10], &[0; 8]);
+    let mut overflow = hint(6);
+    overflow.video_region.as_mut().unwrap().x = u32::MAX;
+    assert_eq!(&t.command(overflow, now, 1280, 720)[2..10], &[0; 8]);
+}
