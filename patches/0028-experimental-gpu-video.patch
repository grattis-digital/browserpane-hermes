+//! GPU video control and encoded-output boundary. Never reads image pixels.
+use crate::cdp_video::{HintRegionKind, PageHintState};
+use anyhow::{ensure, Context};
+use bpane_protocol::channel::ChannelId;
+use bpane_protocol::frame::Frame;
+use bpane_protocol::{VideoDatagram, VideoTileInfo};
+use std::time::{Duration, Instant};
+
+pub struct HintTracker {
+    sequence: u64,
+    changed_at: Instant,
+    candidate: Option<[u16; 4]>,
+    stable: u8,
+}
+impl HintTracker {
+    pub fn new(now: Instant) -> Self {
+        Self {
+            sequence: 0,
+            changed_at: now,
+            candidate: None,
+            stable: 0,
+        }
+    }
+    pub fn command(
+        &mut self,
+        hint: PageHintState,
+        now: Instant,
+        width: u16,
+        height: u16,
+    ) -> [u8; 16] {
+        let fresh = hint.update_seq != self.sequence;
+        if fresh {
+            self.sequence = hint.update_seq;
+            self.changed_at = now;
+        }
+        let region = if hint.visible
+            && !hint.focus_ambiguous
+            && hint.region_kind == HintRegionKind::Video
+            && now.saturating_duration_since(self.changed_at) < Duration::from_millis(500)
+        {
+            hint.video_region.and_then(|r| {
+                // Keep odd edges lossless; never stretch the video to a tile grid.
+                let x = r.x.checked_add(1)? & !1;
+                let y = r.y.checked_add(1)? & !1;
+                let right = r.x.checked_add(r.w)?.min(width as u32) & !1;
+                let bottom = r.y.checked_add(r.h)?.min(height as u32) & !1;
+                let w = right.checked_sub(x)?;
+                let h = bottom.checked_sub(y)?;
+                (w >= 64 && h >= 64).then_some([x as u16, y as u16, w as u16, h as u16])
+            })
+        } else {
+            None
+        };
+        if region != self.candidate {
+            self.candidate = region;
+            self.stable = u8::from(fresh);
+        } else if fresh {
+            self.stable = self.stable.saturating_add(1);
+        }
+        let rect = region.filter(|_| self.stable >= 2).unwrap_or([0; 4]);
+        let mut bytes = [0; 16];
+        bytes[0] = 0x10;
+        bytes[1] = 1;
+        for (i, value) in rect.into_iter().chain([width, height]).enumerate() {
+            bytes[2 + 2 * i..4 + 2 * i].copy_from_slice(&value.to_le_bytes());
+        }
+        bytes
+    }
+}
+
+pub struct EncodedVideo<'a> {
+    pub tile: VideoTileInfo,
+    pub pts: u64,
+    pub nals: Vec<&'a [u8]>,
+}
+impl<'a> EncodedVideo<'a> {
+    pub fn parse(bytes: &'a [u8]) -> anyhow::Result<Self> {
+        ensure!((29..=1_048_600).contains(&bytes.len()), "GPU video size");
+        ensure!(
+            bytes[0] == 1 && bytes[1] == 0 && bytes[22..24] == [0, 0],
+            "GPU video version/reserved"
+        );
+        let mut r = [0u16; 6];
+        for (i, value) in r.iter_mut().enumerate() {
+            *value = u16::from_le_bytes(bytes[2 + 2 * i..4 + 2 * i].try_into()?);
+        }
+        ensure!(
+            r[2] >= 64
+                && r[3] >= 64
+                && r[4] <= 1920
+                && r[5] <= 1080
+                && r[0] as u32 + r[2] as u32 <= r[4] as u32
+                && r[1] as u32 + r[3] as u32 <= r[5] as u32
+                && r[..4].iter().all(|v| v % 2 == 0),
+            "GPU video rectangle"
+        );
+        let data = &bytes[24..];
+        let mut starts = Vec::new();
+        let mut at = 0;
+        while at + 3 <= data.len() {
+            let length = if data[at..].starts_with(&[0, 0, 0, 1]) {
+                4
+            } else if data[at..].starts_with(&[0, 0, 1]) {
+                3
+            } else {
+                at += 1;
+                continue;
+            };
+            ensure!(
+                starts.len() < 128 && at + length < data.len(),
+                "GPU video NAL bound"
+            );
+            starts.push((at, length));
+            at += length;
+        }
+        ensure!(
+            starts.first().is_some_and(|s| s.0 == 0),
+            "GPU video Annex B prefix"
+        );
+        let mut nals = Vec::with_capacity(starts.len());
+        for (i, &(start, prefix)) in starts.iter().enumerate() {
+            let end = starts.get(i + 1).map_or(data.len(), |s| s.0);
+            ensure!(
+                end > start + prefix && data[start + prefix] & 0x80 == 0,
+                "GPU video NAL header"
+            );
+            nals.push(&data[start..end]);
+        }
+        Ok(Self {
+            tile: VideoTileInfo {
+                tile_x: r[0],
+                tile_y: r[1],
+                tile_w: r[2],
+                tile_h: r[3],
+                screen_w: r[4],
+                screen_h: r[5],
+            },
+            pts: u64::from_le_bytes(bytes[14..22].try_into()?),
+            nals,
+        })
+    }
+    pub async fn forward(
+        &self,
+        id: &mut u32,
+        output: &tokio::sync::mpsc::Sender<Frame>,
+    ) -> anyhow::Result<()> {
+        for nal in &self.nals {
+            let prefix = if nal.starts_with(&[0, 0, 0, 1]) { 4 } else { 3 };
+            let kind = nal[prefix] & 31;
+            // SPS/PPS must use the existing reliable keyframe transport too.
+            if !matches!(kind, 1 | 5 | 6 | 7 | 8) {
+                continue;
+            }
+            *id = id.checked_add(1).context("GPU video sequence exhausted")?;
+            for frag in VideoDatagram::fragment_with_tile(
+                *id,
+                matches!(kind, 5 | 7 | 8),
+                self.pts,
+                nal,
+                crate::video_datagram_max_fragment_size(Some(self.tile)),
+                Some(self.tile),
+            ) {
+                tokio::time::timeout(
+                    Duration::from_secs(5),
+                    output.send(Frame::new(ChannelId::Video, frag.encode())),
+                )
+                .await??;
+            }
+        }
+        Ok(())
+    }
+}
+
