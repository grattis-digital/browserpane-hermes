+            screen_w: 1280,
+            screen_h: 720,
+        }
+    }
+    #[test]
+    fn only_one_bounded_access_unit_after_matching_complete_batch() {
+        assert!(GpuOutput::default().video_header(32).is_err());
+        let mut s = ready();
+        assert!(s.video_header(usize::MAX).is_err());
+        s.video_header(32).unwrap();
+        s.video(info()).unwrap();
+        assert!(s.video(info()).is_err());
+        assert!(s.video_header(32).is_err());
+    }
+    #[test]
+    fn move_resize_exit_and_incomplete_batch_cannot_authorize_old_video() {
+        let mut s = ready();
+        let mut wrong = info();
+        wrong.screen_w = 1920;
+        assert!(s.video(wrong).is_err());
+        wrong = info();
+        wrong.tile_x += 2;
+        assert!(s.video(wrong).is_err());
+        s.tile(
+            TileMessage::GpuBegin {
+                epoch: 1,
+                frame_seq: 2,
+            },
+            14,
+        )
+        .unwrap();
+        assert!(s.video(info()).is_err());
+        assert!(s.tile(TileMessage::BatchEnd { frame_seq: 3 }, 5).is_err());
+        s.tile(
+            TileMessage::VideoRegion {
+                x: 0,
+                y: 0,
+                w: 0,
+                h: 0,
+            },
+            9,
+        )
+        .unwrap();
+        s.tile(TileMessage::BatchEnd { frame_seq: 2 }, 5).unwrap();
+        assert!(s.video(info()).is_err());
+    }
+}
