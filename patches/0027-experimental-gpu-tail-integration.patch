+import { describe, expect, it, vi } from 'vitest';
+import { GpuFrameAck } from '../render/gpu-frame-ack.js';
+import { TileMessageParser } from '../render/tile-message-parser.js';
+
+describe('GPU frame ACK ownership', () => {
+  it('emits the exact versioned bytes once, only for the current frame', () => {
+    const sender = vi.fn(), ack = new GpuFrameAck(); ack.setSender(sender);
+    ack.begin(0x0102030405060708n, 0x11223344);
+    ack.finish(1); expect(sender).not.toHaveBeenCalled();
+    ack.finish(0x11223344);
+    expect([...sender.mock.calls[0][0]]).toEqual([14,1,8,7,6,5,4,3,2,1,68,51,34,17,0]);
+    ack.finish(0x11223344); expect(sender).toHaveBeenCalledTimes(1);
+  });
+  it('rejects an incomplete batch and cannot ACK after reset', () => {
+    const sender = vi.fn(), ack = new GpuFrameAck(); ack.setSender(sender);
+    ack.begin(99n, 2); ack.finish(2, true);
+    expect(sender.mock.calls[0][0][14]).toBe(1);
+    ack.begin(99n, 3); ack.reset(); ack.finish(3); expect(sender).toHaveBeenCalledTimes(1);
+  });
+  it('ignores stale completions when a new snapshot supersedes an old batch', () => {
+    const sender = vi.fn(), ack = new GpuFrameAck(); ack.setSender(sender);
+    ack.begin(99n, 2); ack.begin(99n, 3); ack.finish(2);
+    expect(sender).not.toHaveBeenCalled(); ack.finish(3); expect(sender).toHaveBeenCalledTimes(1);
+  });
+  it('fails closed without an ACK route or on invalid leases', () => {
+    const ack = new GpuFrameAck(); expect(() => ack.begin(1n, 1)).toThrow();
+    ack.setSender(() => {});
+    for (const epoch of [0n, -1n, 1n << 64n]) expect(() => ack.begin(epoch, 1)).toThrow();
+    for (const seq of [0,-1,1.5,2 ** 32,NaN]) expect(() => ack.begin(1n, seq)).toThrow();
+  });
+  it('strictly parses GPU begin messages, including byte offsets', () => {
+    const bytes = Uint8Array.from([13,1,8,7,6,5,4,3,2,1,68,51,34,17]);
+    expect(TileMessageParser.parse(bytes)).toEqual({ type: 'gpu-begin', epoch: 0x0102030405060708n, frameSeq: 0x11223344 });
+    for (let n=0; n<bytes.length; n++) expect(TileMessageParser.parse(bytes.slice(0,n))).toBeNull();
+    expect(TileMessageParser.parse(Uint8Array.from([...bytes,0]))).toBeNull();
+    const bad=bytes.slice(); bad[1]=2; expect(TileMessageParser.parse(bad)).toBeNull();
+  });
+});
