+++ b/code/shared/bpane-protocol/src/frame/tests/gpu_tile.rs
@@ -0,0 +1,36 @@
+use crate::{frame::FrameError, TileMessage};
+
+#[test]
+fn gpu_lease_wire_is_exact_and_versioned() {
+    let begin = TileMessage::GpuBegin {
+        epoch: 0x0102030405060708,
+        frame_seq: 0x11223344,
+    };
+    let bytes = vec![13, 1, 8, 7, 6, 5, 4, 3, 2, 1, 68, 51, 34, 17];
+    assert_eq!(begin.encode(), bytes);
+    assert_eq!(TileMessage::decode(&bytes).unwrap(), begin);
+    for n in 0..bytes.len() {
+        assert!(TileMessage::decode(&bytes[..n]).is_err());
+    }
+    let mut extra = bytes.clone();
+    extra.push(0);
+    assert!(TileMessage::decode(&extra).is_err());
+    let mut bad = bytes;
+    bad[1] = 2;
+    assert!(matches!(
+        TileMessage::decode(&bad),
+        Err(FrameError::InvalidFieldValue { .. })
+    ));
+    for rejected in [false, true] {
+        let ack = TileMessage::GpuAck {
+            epoch: 7,
+            frame_seq: 99,
+            rejected,
+        };
+        let mut wire = ack.encode();
+        assert_eq!(wire.len(), 15);
+        assert_eq!(TileMessage::decode(&wire).unwrap(), ack);
+        wire[14] = 2;
+        assert!(TileMessage::decode(&wire).is_err());
+    }
+}
