@@ -0,0 +1,28 @@
+/** One GPU lease at a time. ACK means complete ordered drawing, not scanout. */
+export class GpuFrameAck {
+  private pending: { epoch: bigint; frameSeq: number } | null = null;
+  private send: ((payload: Uint8Array) => void) | null = null;
+
+  public setSender(send: ((payload: Uint8Array) => void) | null): void { this.send = send; }
+
+  public begin(epoch: bigint, frameSeq: number): void {
+    if (epoch <= 0n || epoch > 0xffffffffffffffffn || !Number.isInteger(frameSeq)
+      || frameSeq <= 0 || frameSeq > 0xffffffff) throw new Error('Invalid GPU lease');
+    if (!this.send) throw new Error('GPU lease acknowledgement unavailable');
+    this.pending = { epoch, frameSeq };
+  }
+
+  public reset(): void { this.pending = null; }
+
+  public isPending(frameSeq: number): boolean { return this.pending?.frameSeq === frameSeq; }
+
+  public finish(frameSeq: number, rejected = false): void {
+    if (!this.pending || this.pending.frameSeq !== frameSeq) return;
+    const payload = new Uint8Array(15), view = new DataView(payload.buffer);
+    payload[0] = 0x0E; payload[1] = 1;
+    view.setBigUint64(2, this.pending.epoch, true);
+    view.setUint32(10, frameSeq, true); payload[14] = Number(rejected);
+    if (!this.send) throw new Error('GPU lease acknowledgement disconnected');
+    this.send(payload); this.pending = null;
+  }
+}
