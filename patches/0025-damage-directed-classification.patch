index 0000000..b664c5a
--- /dev/null
+++ b/code/apps/bpane-host/src/tile_loop/classification_hashes.rs
@@ -0,0 +1,87 @@
+//! Reuse only known-equal captured pixels, or omit hashes with no video consumer.
+//! The emitter owns independent lossless hashes. A video hint returning after an
+//! inactive period lazily hashes the previous image: no stale classification
+//! baseline, missing first motion, or disabling video to win a benchmark.
+use crate::capture::region::PixelRect;
+use crate::region::hash_tile_region;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct ClassificationWork {
+    pub current_tiles: u32,
+    pub previous_tiles: u32,
+    pub reused_tiles: u32,
+    pub inactive_tiles: u32,
+}
+
+pub(super) struct ClassificationHashes<'a> {
+    enabled: bool,
+    inactive: bool,
+    verified: Option<PixelRect>,
+    current: &'a [u8],
+    previous: Option<&'a [u8]>,
+    stride: usize,
+    work: ClassificationWork,
+}
+
+impl<'a> ClassificationHashes<'a> {
+    pub fn new(
+        enabled: bool,
+        inactive: bool,
+        verified: Option<PixelRect>,
+        current: &'a [u8],
+        previous: Option<&'a [u8]>,
+        stride: usize,
+    ) -> Self {
+        Self {
+            enabled,
+            inactive,
+            verified,
+            current,
+            previous: previous.filter(|frame| frame.len() == current.len()),
+            stride,
+            work: Default::default(),
+        }
+    }
+
+    pub fn resolve(&mut self, tile: (usize, usize, usize, usize), stored: u64) -> (u64, bool) {
+        if self.enabled && self.inactive {
+            self.work.inactive_tiles += 1;
+            return (0, false); // Explicitly invalidate the old classifier-only hash.
+        }
+        let (x, y, w, h) = tile;
+        let mut baseline = stored;
+        if self.enabled && baseline == 0 {
+            if let Some(previous) = self.previous {
+                baseline = hash_tile_region(previous, self.stride, x, y, w, h);
+                self.work.previous_tiles += 1;
+            }
+        }
+        if self.enabled
+            && baseline != 0
+            && self.verified.is_some_and(|r| !Self::intersects(r, tile))
+        {
+            self.work.reused_tiles += 1;
+            return (baseline, false);
+        }
+        self.work.current_tiles += 1;
+        let hash = hash_tile_region(self.current, self.stride, x, y, w, h);
+        (hash, baseline != 0 && hash != baseline)
+    }
+
+    fn intersects(region: PixelRect, tile: (usize, usize, usize, usize)) -> bool {
+        let (rx, ry, rw, rh) = region.bounds();
+        let (x, y, w, h) = tile;
+        x < usize::from(rx) + usize::from(rw)
+            && usize::from(rx) < x + w
+            && y < usize::from(ry) + usize::from(rh)
+            && usize::from(ry) < y + h
+    }
+
+    pub fn work(&self) -> ClassificationWork {
+        self.work
+    }
+}
+
+#[cfg(test)]
+#[path = "classification_hashes_tests.rs"]
+mod tests;
diff --git a/code/apps/bpane-host/src/tile_loop/classification_hashes_tests.rs b/code/apps/bpane-host/src/tile_loop/classification_hashes_tests.rs
