+#[test]
+fn every_readback_selection_reason_is_explicit_and_coverage_is_never_guessed() {
+    let mut capture = DamageReadback::new(true);
+    let previous = vec![0; PixelRect::frame_bytes(SIZE).unwrap()];
+    assert_eq!(
+        capture.region(SIZE, Some(SMALL), false, Some(&previous)),
+        ReadbackChoice::NoHistory
+    );
+    capture.size = Some(SIZE);
+    for (damage, force, reason) in [
+        (None, false, ReadbackChoice::UnknownDamage),
+        (Some((0, 0, 0, 3)), false, ReadbackChoice::InvalidDamage),
+        (
+            Some((0, 0, SIZE.0, SIZE.1)),
+            false,
+            ReadbackChoice::BroadDamage,
+        ),
+        (Some(SMALL), true, ReadbackChoice::Forced),
+    ] {
+        assert_eq!(capture.region(SIZE, damage, force, Some(&previous)), reason);
+    }
+    capture.enabled = false;
+    assert_eq!(
+        capture.region(SIZE, Some(SMALL), false, Some(&previous)),
+        ReadbackChoice::Disabled
+    );
+}
