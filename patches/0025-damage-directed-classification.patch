+//! Numeric, content-free evidence explaining why damage bounds were admitted.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct DamageObservation {
+    pub rects: usize,
+    pub bounds: Option<(u16, u16, u16, u16)>,
+    pub geometry: (u16, u16),
+    pub reason: DamageReason,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum DamageReason {
+    #[default]
+    Unavailable,
+    Known,
+    Invalidated,
+    Empty,
+    AcknowledgeFailed,
+    GeometryMismatch,
+}
+
+impl DamageReason {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Unavailable => "unavailable",
+            Self::Known => "known",
+            Self::Invalidated => "invalidated",
+            Self::Empty => "empty",
+            Self::AcknowledgeFailed => "ack_failed",
+            Self::GeometryMismatch => "geometry_mismatch",
+        }
+    }
+}
