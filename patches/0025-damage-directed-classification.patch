@@ -0,0 +1,125 @@
+//! Real classifier state compared against the unchanged full-hash reference.
+//! X11 is used only to construct the production host state on a disposable display.
+use super::*;
+
+fn host(enabled: bool) -> TileCaptureThread {
+    let mut config = TileCaptureConfig::from_env();
+    config.damage_analysis = enabled;
+    config.video_classification_enabled = true;
+    TileCaptureThread::new(
+        &std::env::var("DISPLAY").unwrap(),
+        337,
+        193,
+        config,
+        tokio_mpsc::channel(4).0,
+        std::sync::mpsc::channel().0,
+        Arc::new(AtomicBool::new(true)),
+        Arc::new(Mutex::new(None)),
+        Arc::new(Mutex::new(Default::default())),
+        Arc::new(AtomicU64::new(0)),
+        std::sync::mpsc::channel().1,
+        std::sync::mpsc::channel().1,
+        std::sync::mpsc::channel().1,
+    )
+    .unwrap()
+}
+
+fn classify(
+    host: &mut TileCaptureThread,
+    pixels: &[u8],
+    hint: bool,
+    verified: Option<crate::capture::region::PixelRect>,
+) -> frame_types::ClassifyResult {
+    let region = hint.then_some(capture::ffmpeg::CaptureRegion {
+        x: 0,
+        y: 0,
+        w: u32::from(host.screen_w),
+        h: u32::from(host.screen_h),
+    });
+    let bounds = hint.then_some((0, 0, host.grid.cols - 1, host.grid.rows - 1));
+    host.classify_tiles(
+        pixels,
+        usize::from(host.screen_w) * 4,
+        verified,
+        region,
+        bounds,
+        5,
+        -1,
+        20,
+        18,
+        12,
+        6,
+        18,
+        4,
+        3,
+        0.10,
+    )
+}
+
+#[test]
+#[ignore = "requires isolated X11 display"]
+fn damage_directed_classification_preserves_video_state_through_hint_gaps() {
+    use crate::capture::region::PixelRect;
+    let (mut reference, mut optimized) = (host(false), host(true));
+    let size = (reference.screen_w, reference.screen_h);
+    let mut pixels = vec![0; PixelRect::frame_bytes(size).unwrap()];
+    let mut skipped = 0;
+    for n in 0..30u16 {
+        let small = n % 3 != 0;
+        let region = PixelRect::new(
+            if small {
+                (51, 61, 80, 70)
+            } else {
+                (0, 0, size.0, size.1)
+            },
+            size,
+        )
+        .unwrap();
+        let packed: Vec<u8> = (0..region.pixels() * 4)
+            .map(|i| (i * 37 + u64::from(n) * 61) as u8)
+            .collect();
+        region.copy(size, &packed, &mut pixels, true).unwrap();
+        let hint = n % 10 != 5 && n % 10 != 6;
+        let known = small.then_some(region);
+        let (a, b) = (
+            classify(&mut reference, &pixels, hint, None),
+            classify(&mut optimized, &pixels, hint, known),
+        );
+        assert_eq!(
+            a.cdp_motion_tiles, b.cdp_motion_tiles,
+            "motion count at {n}"
+        );
+        assert_eq!(
+            a.latched_video_tiles, b.latched_video_tiles,
+            "video latch at {n}"
+        );
+        assert_eq!(
+            reference.video_scores, optimized.video_scores,
+            "scores at {n}"
+        );
+        assert_eq!(reference.video_hold_frames, optimized.video_hold_frames);
+        assert_eq!(
+            reference.non_candidate_streaks,
+            optimized.non_candidate_streaks
+        );
+        assert_eq!(reference.prev_video_bbox, optimized.prev_video_bbox);
+        assert_eq!(reference.stable_bbox_frames, optimized.stable_bbox_frames);
+        for row in 0..reference.grid.rows {
+            for col in 0..reference.grid.cols {
+                let coord = tiles::TileCoord::new(col, row);
+                assert_eq!(
+                    reference.grid.get(coord).unwrap().classification,
+                    optimized.grid.get(coord).unwrap().classification,
+                    "class at frame {n}"
+                );
+            }
+        }
+        skipped += b.work.inactive_tiles + b.work.reused_tiles;
+        reference.prev_frame = Some(pixels.clone());
+        optimized.prev_frame = Some(pixels.clone());
+    }
+    assert!(
+        skipped > 100,
+        "Must actually exercise omitted/reused hashes"
+    );
+}
