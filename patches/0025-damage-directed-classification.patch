@@ -0,0 +1,102 @@
+use super::*;
+
+#[test]
+fn inactive_hashes_rebase_from_previous_pixels_when_hint_returns() {
+    let previous = vec![3; 128 * 96 * 4];
+    let mut current = previous.clone();
+    current[4 * 19] = 55;
+    let mut inactive = ClassificationHashes::new(true, true, None, &current, Some(&previous), 512);
+    assert_eq!(inactive.resolve((0, 0, 64, 64), 123), (0, false));
+    assert_eq!(inactive.work().current_tiles, 0);
+    assert_eq!(inactive.work().inactive_tiles, 1);
+    let mut active = ClassificationHashes::new(true, false, None, &current, Some(&previous), 512);
+    let (hash, changed) = active.resolve((0, 0, 64, 64), 0);
+    assert!(
+        changed,
+        "First active motion must not be lost when the hint returns"
+    );
+    assert_eq!(hash, hash_tile_region(&current, 512, 0, 0, 64, 64));
+    assert_eq!(active.work().previous_tiles, 1);
+    assert_eq!(active.work().current_tiles, 1);
+}
+
+#[test]
+fn inactive_and_regional_paths_match_reference_hashes_across_odd_edges_and_reversals() {
+    let size = (337, 193);
+    let stride = usize::from(size.0) * 4;
+    let mut previous = vec![0; PixelRect::frame_bytes(size).unwrap()];
+    let mut reference = vec![0; 6 * 4];
+    let mut optimized = reference.clone();
+    let mut reused = 0;
+    for n in 0..240u16 {
+        let region = PixelRect::new((n * 13 % 325, n * 17 % 181, 12, 12), size).unwrap();
+        let mut current = previous.clone();
+        region
+            .copy(
+                size,
+                &vec![(n % 251 + 1) as u8; 12 * 12 * 4],
+                &mut current,
+                true,
+            )
+            .unwrap();
+        let active = n % 17 > 3;
+        // Alternating full reads: never trust acknowledged bounds after a full read.
+        let verified = (n % 3 != 0).then_some(region);
+        if verified.is_none() {
+            let tail = current.len() - 4;
+            current[tail] = n as u8;
+        }
+        let mut hashes =
+            ClassificationHashes::new(true, !active, verified, &current, Some(&previous), stride);
+        for row in 0..4 {
+            for col in 0..6 {
+                let (x, y) = (col * 64, row * 64);
+                let tile = (x, y, 64.min(337 - x), 64.min(193 - y));
+                let index = row * 6 + col;
+                let expected = hash_tile_region(&current, stride, tile.0, tile.1, tile.2, tile.3);
+                let (hash, changed) = hashes.resolve(tile, optimized[index]);
+                if active {
+                    assert_eq!(hash, expected, "frame {n}, tile {index}");
+                    assert_eq!(
+                        changed,
+                        reference[index] != 0 && reference[index] != expected
+                    );
+                } else {
+                    assert_eq!((hash, changed), (0, false));
+                }
+                optimized[index] = hash;
+                reference[index] = expected;
+            }
+        }
+        reused += hashes.work().reused_tiles;
+        previous = current;
+    }
+    assert!(
+        reused > 1000,
+        "Must exercise real retained classifier hashes"
+    );
+}
+
+#[test]
+fn disabled_and_unknown_history_paths_preserve_full_hash_behavior() {
+    let current = vec![3; 64 * 64 * 4];
+    let invalid_previous = vec![0; 4];
+    let region = PixelRect::new((0, 0, 1, 1), (64, 64));
+    for enabled in [false, true] {
+        let mut hashes = ClassificationHashes::new(
+            enabled,
+            false,
+            region,
+            &current,
+            Some(&invalid_previous),
+            256,
+        );
+        let (hash, changed) = hashes.resolve((0, 0, 64, 64), 0);
+        assert_eq!(hash, hash_tile_region(&current, 256, 0, 0, 64, 64));
+        assert!(!changed);
+        assert_eq!(hashes.work().previous_tiles, 0);
+    }
+    let mut disabled = ClassificationHashes::new(false, true, region, &current, None, 256);
+    assert_ne!(disabled.resolve((0, 0, 64, 64), 0).0, 0);
+    assert_eq!(disabled.work().inactive_tiles, 0);
+}
