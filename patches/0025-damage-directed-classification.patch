diff --git a/code/apps/bpane-host/src/tile_loop/readback_choice.rs b/code/apps/bpane-host/src/tile_loop/readback_choice.rs
new file mode 100644
index 0000000..452dcd1
--- /dev/null
+++ b/code/apps/bpane-host/src/tile_loop/readback_choice.rs
@@ -0,0 +1,34 @@
+use crate::capture::region::PixelRect;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) enum ReadbackChoice {
+    #[default]
+    Disabled,
+    Forced,
+    NoHistory,
+    UnknownDamage,
+    InvalidDamage,
+    BroadDamage,
+    Regional(PixelRect),
+}
+
+impl ReadbackChoice {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Disabled => "disabled",
+            Self::Forced => "forced",
+            Self::NoHistory => "no_history",
+            Self::UnknownDamage => "unknown_damage",
+            Self::InvalidDamage => "invalid_damage",
+            Self::BroadDamage => "broad_damage",
+            Self::Regional(_) => "regional",
+        }
+    }
+
+    pub fn region(self) -> Option<PixelRect> {
+        match self {
+            Self::Regional(region) => Some(region),
+            _ => None,
+        }
+    }
+}
