diff --git a/code/web/bpane-client/js/__tests__/scroll-copy-rect.test.ts b/code/web/bpane-client/js/__tests__/scroll-copy-rect.test.ts
new file mode 100644
index 0000000..734e2b5
--- /dev/null
+++ b/code/web/bpane-client/js/__tests__/scroll-copy-rect.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest';
+import { resolveScrollCopyRect } from '../render/scroll-copy-rect.js';
+
+describe('resolveScrollCopyRect', () => {
+  const request = { canvasWidth: 640, canvasHeight: 480, screenW: 640, screenH: 480,
+    dx: 0, dy: 0, regionTop: 64, regionBottom: 400, regionRight: 600 };
+
+  it.each([[20, 32], [-20, 32], [20, -32], [-20, -32]])('preserves exact regional source/destination correspondence for (%i,%i)', (dx, dy) => {
+    const rect = resolveScrollCopyRect({ ...request, dx, dy })!;
+    expect(rect.width).toBe(580);
+    expect(rect.height).toBe(304);
+    expect(rect.sourceX - rect.destinationX).toBe(dx);
+    expect(rect.sourceY - rect.destinationY).toBe(dy);
+    expect(Math.min(rect.sourceX, rect.destinationX)).toBe(0);
+    expect(Math.min(rect.sourceY, rect.destinationY)).toBe(64);
+    expect(Math.max(rect.sourceX, rect.destinationX) + rect.width).toBe(600);
+    expect(Math.max(rect.sourceY, rect.destinationY) + rect.height).toBe(400);
+  });
+
+  it('clips both source and destination to the real backing canvas', () => {
+    expect(resolveScrollCopyRect({ ...request, canvasWidth: 300, canvasHeight: 200, dx: 10, dy: 20 })).toEqual({
+      sourceX: 10, sourceY: 84, destinationX: 0, destinationY: 64, width: 290, height: 116,
+    });
+  });
+
+  it.each([{ dy: 336 }, { dx: -600 }, { regionBottom: 64 }, { regionTop: 481 }, { dx: NaN }, { dy: 1.5 }])('rejects empty or invalid intersections: %j', (change) => {
+    expect(resolveScrollCopyRect({ ...request, dy: 10, ...change })).toBeNull();
+  });
+});
