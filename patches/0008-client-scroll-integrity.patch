diff --git a/code/web/bpane-client/js/render/scroll-copy-rect.ts b/code/web/bpane-client/js/render/scroll-copy-rect.ts
new file mode 100644
index 0000000..1cb21e5
--- /dev/null
+++ b/code/web/bpane-client/js/render/scroll-copy-rect.ts
@@ -0,0 +1,30 @@
+export interface ScrollCopyRectInput {
+  canvasWidth: number;
+  canvasHeight: number;
+  screenW: number;
+  screenH: number;
+  dx: number;
+  dy: number;
+  regionTop: number;
+  regionBottom: number;
+  regionRight: number;
+}
+
+/** The surviving source/destination intersection, in top-left pixel coordinates. */
+export function resolveScrollCopyRect(input: ScrollCopyRectInput): {
+  sourceX: number; sourceY: number; destinationX: number; destinationY: number;
+  width: number; height: number;
+} | null {
+  if (!Object.values(input).every(Number.isSafeInteger)) return null;
+  const right = Math.min(input.regionRight, input.screenW, input.canvasWidth);
+  const top = Math.max(0, input.regionTop);
+  const bottom = Math.min(input.regionBottom, input.screenH, input.canvasHeight);
+  const width = right - Math.abs(input.dx);
+  const height = bottom - top - Math.abs(input.dy);
+  if (width <= 0 || height <= 0 || (input.dx === 0 && input.dy === 0)) return null;
+  return {
+    sourceX: Math.max(0, input.dx), sourceY: top + Math.max(0, input.dy),
+    destinationX: Math.max(0, -input.dx), destinationY: top + Math.max(0, -input.dy),
+    width, height,
+  };
+}
