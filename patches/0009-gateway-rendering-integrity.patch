+#[derive(Default)]
+struct BootstrapVideoState {
+    tile_screen: Option<(u16, u16)>,
+    region: Option<VideoTileInfo>,
+    pending_keyframe: Option<PendingKeyframe>,
+    sps: Option<ParameterSet>,
+    pps: Option<ParameterSet>,
+    invalidated: bool,
+}
+
+// Bootstrap is an optional latency optimization, not a second video stream.
+// Keep at most one bounded in-progress NAL, two parameter sets, and the last
+// complete three-frame SPS/PPS/IDR bootstrap bundle.
+const MAX_BOOTSTRAP_KEYFRAME_BYTES: usize = 4 * 1024 * 1024;
+const MAX_BOOTSTRAP_KEYFRAME_FRAGMENTS: u16 = 4096;
+const MAX_BOOTSTRAP_PARAMETER_BYTES: usize = 64 * 1024;
+
+struct ParameterSet {
+    frame: Arc<Frame>,
+    nal_id: u32,
+    pts_us: u64,
+}
+
+struct PendingKeyframe {
+    video: VideoDatagram,
+    next_fragment: u16,
+}
+
+impl BootstrapVideoState {
+    fn invalidate(&mut self) {
+        self.pending_keyframe = None;
+        self.sps = None;
+        self.pps = None;
+        self.invalidated = true;
+    }
+
+    fn bundle(&mut self, complete: Frame) -> Option<Vec<Arc<Frame>>> {
+        let video = VideoDatagram::decode(&complete.payload).ok()?;
+        let follows = |previous: &ParameterSet| {
+            let delta = video.nal_id.wrapping_sub(previous.nal_id);
+            delta > 0 && delta < 0x8000_0000 && video.pts_us >= previous.pts_us
+        };
+        let nal_type = annex_b_nal_type(&video.data);
+        if matches!(nal_type, Some(7 | 8)) {
+            // Parameters can change before the next IDR. Never replay an old
+            // IDR with new parameters, or retain arbitrary SEI/user payloads.
+            self.invalidated = true;
+            if video.data.len() > MAX_BOOTSTRAP_PARAMETER_BYTES {
+                self.invalidate();
+                return None;
+            }
+            let parameter = ParameterSet {
+                frame: Arc::new(complete),
+                nal_id: video.nal_id,
+                pts_us: video.pts_us,
+            };
+            if nal_type == Some(7) {
+                self.sps = Some(parameter);
+                self.pps = None;
+            } else if self.sps.as_ref().is_some_and(follows) {
+                self.pps = Some(parameter);
+            } else {
+                self.invalidate();
+            }
+            return None;
+        }
+        if nal_type != Some(5) {
+            return None;
+        }
+        let (sps, pps) = (self.sps.as_ref()?, self.pps.as_ref()?);
+        if !follows(pps) {
+            self.invalidate();
+            return None;
+        }
+        Some(vec![
+            sps.frame.clone(),
+            pps.frame.clone(),
+            Arc::new(complete),
+        ])
+    }
+
+    fn owns(&self, video: &VideoDatagram) -> bool {
+        match self.tile_screen {
+            Some(_) => self.region.is_some() && video.tile_info == self.region,
+            None => video.tile_info.is_none(),
+        }
+    }
+
+    fn observe_video(&mut self, frame: &Frame) -> Option<Frame> {
+        // Reject before decoding a malicious/oversized encoded fragment. Live
+        // forwarding is unaffected; this is only the optional bootstrap cache.
+        if frame.payload.len() > MAX_BOOTSTRAP_KEYFRAME_BYTES + 34 {
+            self.invalidate();
+            return None;
+        }
+        let Ok(video) = VideoDatagram::decode(&frame.payload) else {
+            self.invalidate();
+            return None;
+        };
+        if !video.is_keyframe
+            || !self.owns(&video)
+            || video.fragment_total == 0
+            || video.fragment_total > MAX_BOOTSTRAP_KEYFRAME_FRAGMENTS
+            || video.fragment_seq >= video.fragment_total
+            || video.data.len() > MAX_BOOTSTRAP_KEYFRAME_BYTES
+        {
+            self.invalidate();
+            return None;
+        }
+        if video.fragment_total == 1 {
+            self.pending_keyframe = None;
+            return Some(frame.clone());
+        }
+        if video.fragment_seq == 0 {
+            self.pending_keyframe = Some(PendingKeyframe {
+                video,
+                next_fragment: 1,
+            });
+            return None;
+        }
+        let pending = self.pending_keyframe.as_mut()?;
+        if video.fragment_seq != pending.next_fragment
+            || video.nal_id != pending.video.nal_id
+            || video.pts_us != pending.video.pts_us
+            || video.fragment_total != pending.video.fragment_total
+            || video.tile_info != pending.video.tile_info
+            || pending.video.data.len() + video.data.len() > MAX_BOOTSTRAP_KEYFRAME_BYTES
+        {
+            self.invalidate();
+            return None;
+        }
+        let next_len = pending.video.data.len() + video.data.len();
+        if next_len > pending.video.data.capacity() {
+            let capacity = pending
+                .video
+                .data
+                .capacity()
+                .saturating_mul(2)
+                .max(next_len)
+                .min(MAX_BOOTSTRAP_KEYFRAME_BYTES);
+            pending
+                .video
+                .data
+                .reserve_exact(capacity - pending.video.data.len());
+        }
+        pending.video.data.extend_from_slice(&video.data);
+        pending.next_fragment += 1;
+        if pending.next_fragment != pending.video.fragment_total {
+            return None;
+        }
+        let mut complete = self.pending_keyframe.take()?.video;
+        complete.fragment_seq = 0;
+        complete.fragment_total = 1;
+        // Reliable bootstrap frames need not fit the datagram MTU. Repacking
+        // the complete NAL keeps each bundle member one-frame/bounded and lets
+        // the existing client decoder consume parameters and IDR in order.
+        Some(Frame::new(ChannelId::Video, complete.encode()))
+    }
+}
+
+fn annex_b_nal_type(data: &[u8]) -> Option<u8> {
+    if data.starts_with(&[0, 0, 0, 1]) {
+        data.get(4).map(|byte| byte & 0x1F)
+    } else if data.starts_with(&[0, 0, 1]) {
+        data.get(3).map(|byte| byte & 0x1F)
+    } else {
+        None
+    }
+}
