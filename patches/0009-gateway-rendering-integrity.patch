+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn initial_frames() -> Vec<Arc<Frame>> {
+        vec![
+            Arc::new(Frame::new(ChannelId::Control, vec![0x03, 1, 0])),
+            Arc::new(Frame::new(ChannelId::Tiles, vec![0x01])),
+            Arc::new(Frame::new(ChannelId::Video, vec![7])),
+            Arc::new(Frame::new(ChannelId::Video, vec![8])),
+            Arc::new(Frame::new(ChannelId::Video, vec![5])),
+        ]
+    }
+
+    #[test]
+    fn newer_cached_idr_is_not_prepended_to_already_queued_old_p_frames() {
+        let (tx, mut rx) = tokio::sync::broadcast::channel(8);
+        let old_delta = Arc::new(Frame::new(ChannelId::Video, vec![1]));
+        tx.send(old_delta.clone()).unwrap();
+        // Model the pump completing/caching a newer IDR while gather awaits.
+        let mut frames = initial_frames();
+        tx.send(frames.last().unwrap().clone()).unwrap();
+        retain_ordered_video_bootstrap(&mut frames, &rx);
+        assert_eq!(
+            frames.iter().map(|frame| frame.channel).collect::<Vec<_>>(),
+            [ChannelId::Control, ChannelId::Tiles]
+        );
+        assert_eq!(
+            rx.try_recv().unwrap(),
+            old_delta,
+            "live ordering and nonvideo bootstrap remain untouched"
+        );
+    }
+
+    #[test]
+    fn empty_live_queue_preserves_complete_bootstrap_before_future_deltas() {
+        let (tx, mut rx) = tokio::sync::broadcast::channel(8);
+        let mut frames = initial_frames();
+        retain_ordered_video_bootstrap(&mut frames, &rx);
+        assert_eq!(frames.len(), 5);
+        assert_eq!(
+            frames[2..]
+                .iter()
+                .map(|frame| frame.payload[0])
+                .collect::<Vec<_>>(),
+            [7, 8, 5]
+        );
+        let future_delta = Arc::new(Frame::new(ChannelId::Video, vec![1]));
+        tx.send(future_delta.clone()).unwrap();
+        assert_eq!(rx.try_recv().unwrap(), future_delta);
+    }
+}
