+fn retain_ordered_video_bootstrap(
+    initial_frames: &mut Vec<Arc<Frame>>,
+    from_host: &tokio::sync::broadcast::Receiver<Arc<Frame>>,
+) {
+    // subscribe() precedes async cache gathering. A newer IDR may be cached
+    // while older P frames are already queued for this viewer; prepending it
+    // would replay those old deltas against the wrong reference picture.
+    // Without an atomic GOP snapshot, only an empty queue proves the optional
+    // bootstrap bundle can safely precede all future live video frames.
+    if !from_host.is_empty() {
+        initial_frames.retain(|frame| frame.channel != ChannelId::Video);
+    }
+}
