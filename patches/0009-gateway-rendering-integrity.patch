+async fn finish_protocol_rejection(
+    reject: impl std::future::Future<Output = ()>,
+    close_connection: impl FnOnce(),
+) {
+    // A slow viewer may already have another task blocked on write_all while
+    // holding the shared stream lock. Closing must not wait for that lock (or
+    // the reject write itself) forever.
+    let _ = tokio::time::timeout(PROTOCOL_REJECT_DRAIN_TIMEOUT, reject).await;
+    close_connection();
