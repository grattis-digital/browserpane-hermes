+#[test]
+fn retained_scroll_repairs_stationary_footer_in_partial_bottom_tile_row() {
+    for height in [720u16, 767, 768] {
+        let grid = TileGrid::new(1280, height, 64);
+        let stride = usize::from(grid.screen_w) * 4;
+        let top = 87;
+        let right = 1265;
+        let coords: Vec<_> = (0..grid.rows)
+            .flat_map(|row| (0..grid.cols).map(move |col| TileCoord::new(col, row)))
+            .collect();
+        let capture = |origin: u16| -> Vec<u8> {
+            (0..height)
+                .flat_map(|y| {
+                    (0..grid.screen_w).flat_map(move |x| {
+                        if y < top || x >= right {
+                            [192, 192, 192, 255] // fixed browser chrome / scrollbar
+                        } else if y >= height - 27 {
+                            // Unchanged fixed footer: copying moving content over
+                            // it must invalidate static L1 even when capture is equal.
+                            [40, 24, (x % 113) as u8, 255]
+                        } else {
+                            let document_y = y + origin;
+                            [x as u8, document_y as u8, (x ^ document_y) as u8, 255]
+                        }
+                    })
+                })
+                .collect()
+        };
+        let emit = |emitter: &mut TileEmitter, pixels: &[u8], dirty: &[TileCoord]| {
+            let (content, chrome): (Vec<_>, Vec<_>) = dirty.iter().copied().partition(|coord| {
+                is_content_tile_in_scroll_region(*coord, 64, top, height, right)
+            });
+            let mut frames = emitter
+                .emit_frame(pixels, stride, &content, &grid, 0, None, None)
+                .tile_frames;
+            let end = frames.pop().expect("every emission ends its batch");
+            frames.push(
+                TileMessage::TileDrawMode {
+                    apply_offset: false,
+                }
+                .to_frame(),
+            );
+            frames.extend(emitter.emit_static_tiles(
+                pixels,
+                stride,
+                &chrome,
+                &grid,
+                Some(right / 64),
+                Some(top / 64),
+                // Match production: the physical screen edge is NOT a split
+                // boundary. Forcing this row to encode would mask stale L1.
+                None,
+                None,
+                None,
+            ));
+            frames.push(TileMessage::TileDrawMode { apply_offset: true }.to_frame());
+            frames.push(end);
+            frames
+        };
+        let mut emitter = TileEmitter::new(grid.cols, grid.rows);
+        let mut viewer = Viewer::new(&grid);
+        let mut origin = 512u16;
+        let mut previous = capture(origin);
+        viewer.apply(emit(&mut emitter, &previous, &coords), &grid);
+        assert!(viewer.pixels == rgba_from_bgra(&previous));
+        let mut upward_copies = 0;
+        let mut downward_copies = 0;
+        for dy in [-64i16, -128, 64, 128, -64, 64] {
+            origin = (i32::from(origin) + i32::from(dy)) as u16;
+            let current = capture(origin);
+            let scroll = DetectedScrollFrame {
+                dy,
+                confidence: 1.0,
+                source: "test",
+                direction_matches: true,
+                min_confidence: None,
+                row_shift: i32::from(dy) / 64,
+                region_top: top,
+                region_bottom: height,
+                region_right: right,
+            };
+            let partition = partition_and_compare(
+                &current,
+                &previous,
+                stride,
+                &grid,
+                0,
+                64,
+                32,
+                dy,
+                &coords,
+                &scroll,
+                top,
+                height,
+                right,
+                grid.screen_w,
+            );
+            assert!(
+                partition.quantized_scroll_copy && partition.saved_tiles > 0,
+                "footer regression must exercise real retained ScrollCopy"
+            );
+            assert!(
+                partition.interior_ratio <= 0.70,
+                "production must accept this residual without full fallback"
+            );
+            emitter.apply_scroll_copy_to_hashes(
+                &grid,
+                dy,
+                0,
+                Rect::new(0, top, right, height - top),
+            );
+            viewer.apply(
+                [TileMessage::ScrollCopy {
+                    dx: 0,
+                    dy,
+                    region_top: top,
+                    region_bottom: height,
+                    region_right: right,
+                }
+                .to_frame()],
+                &grid,
+            );
+            if dy < 0 {
+                upward_copies += 1;
+            } else {
+                downward_copies += 1;
+            }
+            let dirty: Vec<_> = partition
+                .residual
+                .into_iter()
+                .chain(partition.chrome_emit_coords)
+                .collect();
+            viewer.apply(emit(&mut emitter, &current, &dirty), &grid);
+            let expected = rgba_from_bgra(&current);
+            let bad: Vec<_> = viewer
+                .pixels
+                .chunks_exact(4)
+                .zip(expected.chunks_exact(4))
+                .enumerate()
+                .filter_map(|(index, (a, b))| (a != b).then_some(index))
+                .collect();
+            assert!(bad.is_empty(),
+                "stationary footer corrupted: height={height}, dy={dy}, wrong_pixels={}, first_xy={:?}",
+                bad.len(), bad.first().map(|index| (index % 1280, index / 1280)));
+            previous = current;
+        }
+        assert_eq!((upward_copies, downward_copies), (3, 3));
+    }
+}
