     {
         return None;
     }
+    let max_dy = max_search.min(height / 2);
+    if max_dy == 0 {
+        return None;
+    }
+    let sample_xs = [10, 30, 50, 70, 90].map(|pct| (pct * width / 100).min(width - 1));
+    let sampled_end = (height - 1) * stride + sample_xs[4] * 4 + 4;
+    if sampled_end > current.len() || sampled_end > previous.len() {
+        // Preserve the original individual-pixel bounds behavior for unusual
+        // undersized strides. Real capture frames, including padded strides,
+        // use the packed fast path below.
+        return detect_column_scroll_strided(current, previous, stride, width, height, max_search);
+    }
+
+    // Read strided framebuffer memory only once. Five columns from both 720p
+    // images occupy 28 KiB; candidate comparisons are contiguous u32 equality
+    // scans instead of repeatedly walking megabytes of row-strided pixels.
+    // Native endian is immaterial: equality preserves all four BGRA bytes.
+    let mut current_columns = Vec::with_capacity(height * sample_xs.len());
+    let mut previous_columns = Vec::with_capacity(height * sample_xs.len());
+    for &col_x in &sample_xs {
+        for y in 0..height {
+            let offset = y * stride + col_x * 4;
+            current_columns.push(u32::from_ne_bytes(
+                current[offset..offset + 4].try_into().unwrap(),
+            ));
+            previous_columns.push(u32::from_ne_bytes(
+                previous[offset..offset + 4].try_into().unwrap(),
+            ));
+        }
+    }
+
+    let mut best_dy: i32 = 0;
+    let mut best_total_matches: usize = 0;
+    let mut best_agreeing_cols: usize = 0;
+    // Deliberately retain candidate order, strict comparisons and unnormalized
+    // total-match scoring, including the original positive-direction tie break.
+    for dy in 1..=max_dy {
+        for sign in [1i32, -1i32] {
+            let signed_dy = dy as i32 * sign;
+            let overlap = height - dy;
+            let mut total_matches = 0usize;
+            let mut agreeing_cols = 0usize;
+            for column in 0..sample_xs.len() {
+                let base = column * height;
+                let (current_start, previous_start) = if sign > 0 {
+                    (base, base + dy)
+                } else {
+                    (base + dy, base)
+                };
+                let current = &current_columns[current_start..current_start + overlap];
+                let previous = &previous_columns[previous_start..previous_start + overlap];
+                let col_matches = current.iter().zip(previous).filter(|(a, b)| a == b).count();
+                let col_confidence = col_matches as f32 / overlap as f32;
+                if col_confidence > 0.6 {
+                    agreeing_cols += 1;
+                }
+                total_matches += col_matches;
+            }
+            if agreeing_cols >= 3 && total_matches > best_total_matches {
+                best_total_matches = total_matches;
+                best_dy = signed_dy;
+                best_agreeing_cols = agreeing_cols;
+            }
+        }
+    }
+    if best_dy == 0 || best_agreeing_cols < 3 {
+        return None;
+    }
+    let overlap = height - best_dy.unsigned_abs() as usize;
+    let confidence = best_total_matches as f32 / (overlap * sample_xs.len()) as f32;
+    if confidence > 0.7 {
+        Some((best_dy, confidence))
+    } else {
+        None
+    }
