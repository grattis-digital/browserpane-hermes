@@ -134,3 +134,38 @@ async fn failed_keyframe_never_releases_dependent_deltas() {
         .await
         .is_err());
 }
+
+#[tokio::test]
+async fn a_keyframe_cannot_jump_over_preceding_queued_deltas() {
+    let (mut lanes, reliable, video) = EgressLanes::new();
+    lanes.datagram(Bytes::from_static(b"old delta")).unwrap();
+    lanes
+        .reliable(Bytes::from_static(b"new idr"), true)
+        .unwrap();
+    lanes.datagram(Bytes::from_static(b"new delta")).unwrap();
+    let trace = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let writes = trace.clone();
+    let writer = tokio::spawn(reliable.run(move |bytes| {
+        writes.lock().unwrap().push(bytes.to_vec());
+        async { Ok(()) }
+    }));
+    tokio::task::yield_now().await;
+    assert!(trace.lock().unwrap().is_empty()); // old delta has not been sent
+    let sends = trace.clone();
+    let sender = tokio::spawn(video.run(move |bytes| sends.lock().unwrap().push(bytes.to_vec())));
+    drop(lanes);
+    tokio::time::timeout(std::time::Duration::from_secs(1), async {
+        writer.await.unwrap().unwrap();
+        sender.await.unwrap().unwrap();
+    })
+    .await
+    .unwrap();
+    assert_eq!(
+        *trace.lock().unwrap(),
+        [
+            b"old delta".to_vec(),
+            b"new idr".to_vec(),
+            b"new delta".to_vec()
+        ]
+    );
+}
