--- /dev/null
+++ b/code/web/bpane-client/js/__tests__/video-frame-queue.test.ts
@@ -0,0 +1,38 @@
+import { describe, expect, it, vi } from 'vitest';
+import { VideoFrameQueue } from '../render/video-frame-queue.js';
+
+const frame = () => ({ close: vi.fn() }) as unknown as VideoFrame;
+
+describe('VideoFrameQueue', () => {
+  it('retains three brief-burst frames in order and closes overflow', () => {
+    const q = new VideoFrameQueue(), frames = Array.from({ length: 5 }, frame);
+    expect(frames.map(f => q.push(f, null, 100))).toEqual([0, 0, 0, 1, 1]);
+    expect(q.size).toBe(3);
+    for (const f of frames.slice(0, 2)) expect(f.close).toHaveBeenCalledOnce();
+    for (const f of frames.slice(2)) {
+      expect(q.take(110).pending?.frame).toBe(f);
+      expect(f.close).not.toHaveBeenCalled(); // ownership handed to compositor
+      f.close();
+    }
+    expect(q.size).toBe(0);
+  });
+
+  it('discards old buffered motion after a slow/background RAF', () => {
+    const q = new VideoFrameQueue(), a = frame(), b = frame(), c = frame();
+    q.push(a, null, 100); q.push(b, null, 110); q.push(c, null, 140);
+    const result = q.take(170);
+    expect(result.discarded).toBe(2);
+    expect(result.pending?.frame).toBe(c);
+    expect(a.close).toHaveBeenCalledOnce();
+    expect(b.close).toHaveBeenCalledOnce();
+    c.close();
+  });
+
+  it('clear closes all owned frames exactly once', () => {
+    const q = new VideoFrameQueue(), frames = Array.from({ length: 3 }, frame);
+    for (const f of frames) q.push(f, null, 100);
+    expect(q.clear()).toBe(3); expect(q.clear()).toBe(0);
+    for (const f of frames) expect(f.close).toHaveBeenCalledOnce();
+    expect(q.take(100).pending).toBeNull();
+  });
+});
diff --git a/code/web/bpane-client/js/render/video-frame-queue.ts b/code/web/bpane-client/js/render/video-frame-queue.ts
new file mode 100644
index 0000000..8b1324f
--- /dev/null
+++ b/code/web/bpane-client/js/render/video-frame-queue.ts
@@ -0,0 +1,34 @@
+import type { TileInfo } from '../nal.js';
+
+type PendingFrame = { frame: VideoFrame; tileInfo: TileInfo | null; receivedAt: number };
+
+/** At most three GPU-backed frames; no copies, timers or prebuffering delay. */
+export class VideoFrameQueue {
+  private readonly frames: PendingFrame[] = [];
+  get size(): number { return this.frames.length; }
+
+  push(frame: VideoFrame, tileInfo: TileInfo | null, receivedAt: number): number {
+    this.frames.push({ frame, tileInfo, receivedAt });
+    if (this.frames.length <= 3) return 0;
+    this.frames.shift()!.frame.close();
+    return 1;
+  }
+
+  take(now: number): { pending: PendingFrame | null; discarded: number } {
+    let discarded = 0;
+    // A delayed/hidden viewer must catch up, not replay stale buffered motion.
+    // Always retain the newest frame if no newer picture has arrived.
+    while (this.frames.length > 1 && now - this.frames[0].receivedAt > 50) {
+      this.frames.shift()!.frame.close();
+      discarded++;
+    }
+    return { pending: this.frames.shift() ?? null, discarded };
+  }
+
+  clear(): number {
+    const count = this.frames.length;
+    for (const item of this.frames) item.frame.close();
+    this.frames.length = 0;
+    return count;
+  }
+}
