diff --git a/code/apps/bpane-host/src/capture/ffmpeg.rs b/code/apps/bpane-host/src/capture/ffmpeg.rs
--- a/code/apps/bpane-host/src/capture/ffmpeg.rs
+++ b/code/apps/bpane-host/src/capture/ffmpeg.rs
@@ -6,6 +6,34 @@ use std::{env, str::FromStr};
 
 use crate::encode::EncodedFrame;
 
+// Both supported servers expose the same exact DUMMY0 geometry contract.
+fn validate_virtual_backend(value: Option<&std::ffi::OsStr>) -> anyhow::Result<()> {
+    match value {
+        None => Ok(()),
+        Some(value) if value == "dummy" || value == "gpu-dummy" => Ok(()),
+        Some(_) => anyhow::bail!("BPANE_X11_BACKEND must be dummy or gpu-dummy"),
+    }
+}
+
+#[cfg(test)]
+mod backend_tests {
+    use super::validate_virtual_backend;
+    use std::ffi::OsStr;
+
+    #[test]
+    fn backend_selection_is_explicit_and_fail_closed() {
+        assert!(validate_virtual_backend(None).is_ok());
+        for value in ["dummy", "gpu-dummy"] {
+            assert!(validate_virtual_backend(Some(OsStr::new(value))).is_ok());
+        }
+        for value in ["", "auto", "GPU-DUMMY", " gpu-dummy", "unsupported"] {
+            assert!(validate_virtual_backend(Some(OsStr::new(value))).is_err());
+        }
+        use std::os::unix::ffi::OsStrExt;
+        assert!(validate_virtual_backend(Some(OsStr::from_bytes(&[0xff]))).is_err());
+    }
+}
+
